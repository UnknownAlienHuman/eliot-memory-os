e::Null;\n1481:                 return Ok(response);\n1482:             }\n1483:             let JobOperation::Start { lease, .. } = &request.operation else {\n1484:                 return Err(\"fake transport start requires the claimed lease\".to_owned());\n1485:             };\n1486:             let lease_json =\n1487:                 serde_json::to_value(lease).map_err(|error| error.to_string())?;\n1488:             let mut response = Self::lease_json(request, &lease_json)?;\n1489:             response[\"state\"] = serde_json::Value::String(\"RUNNING\".to_owned());\n1490:             response[\"receipt_id\"] = serde_json::Value::String(\"dreamer-receipt-start01\".to_owned());\n1491:             Ok(response)\n1492:         }\n1493:     }\n1494: \n1495:     impl ClaimTransport for FakeClaimTransport {\n1496:         fn bind_identity(\n1497:             &mut self,\n1498:             _fence: &StateFence,\n1499:             _operation_id: &str,\n1500:         ) -> Result<(), KernelPortError> {\n1501:             Ok(())\n1502:         }\n1503: \n1504:         fn transact(\n1505:             &mut self,\n1506:             operation: &str,\n1507:             payload: serde_json::Value,\n1508:         ) -> Result<serde_json::Value, KernelPortError> {\n1509:             let denied = |detail: String| KernelPortError::Transport(detail);\n1510:             if operation != DREAMER_JOB_WIRE_ID {\n1511:                 return Err(denied(\n1512:                     \"fake transport admits only the dreamer job wire\".to_owned(),\n1513:                 ));\n1514:             }\n1515:             let request = Self::submitted_request(&payload).map_err(denied)?;\n1516:             let kind = request.operation.kind();\n1517:             let kind_name = kind.as_str().to_owned();\n1518:             if kind == eliot_protocol::dreamer_job::JobOperationKind::LeaseExact {\n1519:                 if self.calls.iter().any(|call| call == \"LEASE_EXACT\") {\n1520:                     return Err(d