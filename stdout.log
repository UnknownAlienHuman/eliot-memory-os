ize, serde::Deserialize)]\n167: #[serde(deny_unknown_fields)]\n168: pub(crate) struct DreamerDispatchedEnvelope {\n169:     /// Exact queued job identity (lookup key; must answer the ledger).\n170:     pub(crate) job_id: String,\n171:     /// Exact queued attempt identity (lookup key; must answer the ledger).\n172:     pub(crate) attempt_id: String,\n173:     /// Exact ledger revision the worker must claim.\n174:     pub(crate) revision: u64,\n175:     /// Scope the ledger bound to this job (never caller bytes).\n176:     pub(crate) scope_id: String,\n177:     /// Fence the ledger bound to this job (never caller bytes).\n178:     pub(crate) fence: StateFence,\n179:     /// Live authority epoch bound at launch (never envelope bytes alone).\n180:     pub(crate) epoch: EpochId,\n181:     /// Live activation generation bound at launch (non-zero).\n182:     pub(crate) generation: u64,\n183:     /// I7.5/I15.2 launch nonce, deterministic per lineage.\n184:     pub(crate) nonce: String,\n185:     /// Kernel-issued launch grant the child derives its permit from.\n186:     pub(crate) grant: DispatchGrant,\n187: }\n188: \n189: /// Session-bound Dreamer material validated against the live authority.\n190: ///\n191: /// Carries exactly what the managed child needs to prove its claim. This\n192: /// value alone (without the local dispatch permit derived from `grant` and\n193: /// without the K2 claim) never drives execution.\n194: #[derive(Clone, Debug, Eq, PartialEq)]\n195: pub(crate) struct ValidatedDreamerMaterial {\n196:     /// Exact queued job identity.\n197:     pub(crate) job_id: String,\n198:     /// Exact queued attempt identity.\n199:     pub(crate) attempt_id: String,\n200:     /// Exact ledger revision the worker must claim.\n201:     pub(crate) revision: u64,\n202:     /// Scope the ledger bound to this job.\n203:     pub(crate) scope_id: String,\n204:     /// Fence the ledger bound to this job.\n205:     pub(crate) fence: StateFence,\n206:     /// Live epoch this 