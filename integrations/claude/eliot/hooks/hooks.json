{
  "description": "[MIGRATED #18: hook commands below invoke bins/eliot-agent-bridge on the admitted SPINE_FUNCTIONAL contour through the Kernel front door; the legacy facade is no longer the hook owner.] Two enforcement points and the session events that carry real ELIOT evidence. Events that change no ELIOT state are deliberately absent: this plugin is installed at user scope, so every hook here fires in every Claude session on the machine. Enforcement runs through `hook <event>`, which emits the exact per-event decision schema and defers when the session is not attached to an ELIOT task. Pure observation is `async` so it cannot hold up a turn; SessionStart is not, because its context has to arrive before the first model request.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/eliot-agent-bridge.exe",
            "args": [
              "mcp",
              "--profile",
              "SPINE_FUNCTIONAL",
              "--transport",
              "stdio",
              "--client-declaration",
              "${CLAUDE_PLUGIN_ROOT}/bin/agent-bridge/client-declaration-v2.json"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/eliot-agent-bridge.exe",
            "args": [
              "mcp",
              "--profile",
              "SPINE_FUNCTIONAL",
              "--transport",
              "stdio",
              "--client-declaration",
              "${CLAUDE_PLUGIN_ROOT}/bin/agent-bridge/client-declaration-v2.json"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/eliot-agent-bridge.exe",
            "args": [
              "mcp",
              "--profile",
              "SPINE_FUNCTIONAL",
              "--transport",
              "stdio",
              "--client-declaration",
              "${CLAUDE_PLUGIN_ROOT}/bin/agent-bridge/client-declaration-v2.json"
            ],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/eliot-agent-bridge.exe",
            "args": [
              "mcp",
              "--profile",
              "SPINE_FUNCTIONAL",
              "--transport",
              "stdio",
              "--client-declaration",
              "${CLAUDE_PLUGIN_ROOT}/bin/agent-bridge/client-declaration-v2.json"
            ],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/eliot-agent-bridge.exe",
            "args": [
              "mcp",
              "--profile",
              "SPINE_FUNCTIONAL",
              "--transport",
              "stdio",
              "--client-declaration",
              "${CLAUDE_PLUGIN_ROOT}/bin/agent-bridge/client-declaration-v2.json"
            ],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/eliot-agent-bridge.exe",
            "args": [
              "mcp",
              "--profile",
              "SPINE_FUNCTIONAL",
              "--transport",
              "stdio",
              "--client-declaration",
              "${CLAUDE_PLUGIN_ROOT}/bin/agent-bridge/client-declaration-v2.json"
            ],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/eliot-agent-bridge.exe",
            "args": [
              "mcp",
              "--profile",
              "SPINE_FUNCTIONAL",
              "--transport",
              "stdio",
              "--client-declaration",
              "${CLAUDE_PLUGIN_ROOT}/bin/agent-bridge/client-declaration-v2.json"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/eliot-agent-bridge.exe",
            "args": [
              "mcp",
              "--profile",
              "SPINE_FUNCTIONAL",
              "--transport",
              "stdio",
              "--client-declaration",
              "${CLAUDE_PLUGIN_ROOT}/bin/agent-bridge/client-declaration-v2.json"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/eliot-agent-bridge.exe",
            "args": [
              "mcp",
              "--profile",
              "SPINE_FUNCTIONAL",
              "--transport",
              "stdio",
              "--client-declaration",
              "${CLAUDE_PLUGIN_ROOT}/bin/agent-bridge/client-declaration-v2.json"
            ],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
