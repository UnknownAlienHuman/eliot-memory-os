{
  "description": "One authority gate plus the session and delegation events that carry real ELIOT evidence. Events that change no ELIOT state are deliberately absent: this plugin is installed at user scope, so every hook here fires in every Claude session on the machine.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/eliot-governor.exe",
            "args": ["host", "event", "--host", "claude", "--event", "SessionStart"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/eliot-governor.exe",
            "args": ["host", "event", "--host", "claude", "--event", "PreToolUse"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/eliot-governor.exe",
            "args": ["host", "event", "--host", "claude", "--event", "PostToolUseFailure"],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/eliot-governor.exe",
            "args": ["host", "event", "--host", "claude", "--event", "SubagentStart"],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/eliot-governor.exe",
            "args": ["host", "event", "--host", "claude", "--event", "SubagentStop"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/eliot-governor.exe",
            "args": ["host", "event", "--host", "claude", "--event", "PreCompact"],
            "timeout": 10
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/eliot-governor.exe",
            "args": ["host", "event", "--host", "claude", "--event", "TaskCompleted"],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/eliot-governor.exe",
            "args": ["host", "event", "--host", "claude", "--event", "SessionEnd"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
