{
  "description": "Two enforcement points and the session events that carry real ELIOT evidence. Events that change no ELIOT state are deliberately absent: this plugin is installed at user scope, so every hook here fires in every Claude session on the machine. Enforcement runs through `hook <event>`, which emits the exact per-event decision schema and defers when the session is not attached to an ELIOT task; pure observation runs through `host event`, which has no decision to make.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/eliot-governor.exe",
            "args": ["hook", "session-start"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/eliot-governor.exe",
            "args": ["hook", "pre-tool-use"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/eliot-governor.exe",
            "args": ["host", "event", "--host", "claude", "--event", "PostToolUseFailure"],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/eliot-governor.exe",
            "args": ["hook", "subagent-start"],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/eliot-governor.exe",
            "args": ["hook", "subagent-stop"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/eliot-governor.exe",
            "args": ["hook", "pre-compact"],
            "timeout": 10
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/eliot-governor.exe",
            "args": ["hook", "stop"],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/eliot-governor.exe",
            "args": ["host", "event", "--host", "claude", "--event", "SessionEnd"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
