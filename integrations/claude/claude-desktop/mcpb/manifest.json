{
  "$schema": "https://raw.githubusercontent.com/anthropics/mcpb/main/schemas/mcpb-manifest-v0.3.schema.json",
  "manifest_version": "0.3",
  "name": "eliot-governor",
  "display_name": "ELIOT Governor",
  "version": "0.1.6",
  "description": "Connect Claude Desktop to the local ELIOT cognitive control plane.",
  "long_description": "Read current task truth, expand exact evidence, use governed memory, delegate bounded work, and submit receipted candidate or verification results through the existing local ELIOT Governor. Claude identity never grants a permanent role.",
  "author": {
    "name": "ELIOT Project"
  },
  "server": {
    "type": "binary",
    "entry_point": "server/eliot-governor.exe",
    "mcp_config": {
      "command": "${__dirname}/server/eliot-governor.exe",
      "args": [
        "mcp",
        "stdio",
        "--host",
        "claude-desktop",
        "--instance",
        "default"
      ],
      "env": {}
    }
  },
  "tools": [],
  "tools_generated": true,
  "prompts": [],
  "prompts_generated": true,
  "keywords": [
    "eliot",
    "memory",
    "agents",
    "verification"
  ],
  "license": "MIT",
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "win32"
    ]
  }
}
