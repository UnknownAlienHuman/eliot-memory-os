  "request_sequence": [
    {
      "method": "initialize",
      "id": 1,
      "params": {
        "clientInfo": {
          "name": "eliot",
          "title": "ELIOT",
          "version": "<crate-version>"
        }
      }
    },
    {
      "method": "initialized",
      "notification": true,
      "params": {}
    },
    {
      "method": "model/list",
      "id": 2,
      "params": {
        "cursor": null,
        "limit": 100,
        "includeHidden": false
      }
    }
  ],
  "wire_rules": {
    "transport": "stdio_jsonl",
    "jsonrpc_member": "forbidden",
    "protocolVersion_member": "forbidden_in_initialize",
    "experimentalApi_member": "omitted_false_by_default",
    "response_id_correlation": "exact",
    "server_error_detail": "not_exposed_in_adapter_error",
    "additive_model_fields": "ignored_without_changing_selected_fields"
  },
  "catalogue_contract": {
    "page_shape": {
      "data": "array<Model>",
      "nextCursor": "string_or_null_required"
    },
    "selected_model_fields": [
      "id",
      "model",
      "upgrade",
      "displayName",
      "description",
      "modelSpecialty",
      "hidden",
      "supportedReasoningEfforts",
      "defaultReasoningEffort",
      "inputModalities",
      "supportsPersonality",
      "isDefault"
    ],
    "duplicate_model_id": "reject",
    "repeated_cursor": "reject",
    "empty_complete_catalogue": "honest_success",
    "model_selection": "not_performed_by_this_diagnostic"
  },
  "bounds": {
    "maximum_jsonl_line_bytes": 4194304,
    "maximum_pages": 32,
    "maximum_models": 4096,
    "default_page_limit": 100
  },
  "forbidden_methods_in_this_slice": [
    "thread/start",
    "thread/resume",
    "thread/fork",
    "turn/start",
    "turn/interrupt",
    "experimental collaboration methods"
  ],
  "proof_entrypoints": [
    "python scripts/verify-codex-app-server-wire.py --self-test",
    "python scripts/verify-codex-app-server-wire.py",
    "cargo test -p eliot-agent-codex app_server_stable_wire --all-targets",
    "cargo run -q -p eliot-agent-codex --bin codex_app_server_preflight -- --emit-requests-only"
  ],
  "proof_ceiling": "Static verification can prove the declared source shape. Executed Rust package proof is still required. Even after package proof, this slice does not prove installed executable compatibility, current-account authentication, model acceptance, thread/turn execution, cancellation, process-tree containment, AgentAttempt completion, or route admission."
