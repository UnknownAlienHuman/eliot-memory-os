{
  "name": "eliot-system",
  "interface": {
    "displayName": "ELIOT System"
  },
  "plugins": [
    {
      "name": "eliot-governor",
      "source": {
        "source": "local",
        "path": "./plugins/eliot-governor"
      },
      "policy": {
        "installation": "INSTALLED_BY_DEFAULT",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools",
      "eliot_mcp_server": {
        "command": "bin/eliot-agent-bridge.exe",
        "args": [
          "mcp",
          "--profile",
          "codex_controller",
          "--transport",
          "stdio",
          "--client-declaration",
          "${PLUGIN_ROOT}/bin/agent-bridge/client-declaration-v2.json"
        ],
        "owner": "bins/eliot-agent-bridge"
      }
    }
  ]
}
