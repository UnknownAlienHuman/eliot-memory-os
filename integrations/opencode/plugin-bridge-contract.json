{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "eliot.opencode-plugin-bridge.v1",
  "surface": "integrations/opencode/plugins/eliot.js",
  "role": "host_observation_and_pre_effect_gate_candidate",
  "authority_ceiling": "candidate_only",
  "preferred_transport": {
    "kind": "loopback_http",
    "configuration": {
      "server_root_env": "ELIOT_OPENCODE_BRIDGE_URL",
      "bearer_token_env": "ELIOT_OPENCODE_BRIDGE_TOKEN",
      "server_identity_env": "ELIOT_OPENCODE_BRIDGE_SERVER_IDENTITY",
      "endpoint": "/v1/host-events",
      "credential_materialization": "user_broker_materialized_child_projection_only__manually_set_env_is_not_an_admitted_installation_path"
    },
    "admission": [
      "http_only",
      "literal_127_0_0_1_or_ipv6_loopback",
      "explicit_port",
      "no_url_credentials",
      "no_query_or_fragment",
      "bearer_token_required",
      "installation_pinned_server_identity_required"
    ],
    "first_contact": {
      "purpose": "plain_loopback_location_is_not_server_identity__the_credential_is_never_the_first_protected_byte",
      "mechanism": "owner_created_exclusively_pre_bound_loopback_listener_plus_installation_pinned_challenge_response_identity",
      "probe_method": "POST",
      "probe_path": "/v1/host-events",
      "probe_challenge_header": "X-ELIOT-Bridge-Challenge",
      "probe_challenge_shape": "lowercase_hex_of_32_client_minted_random_bytes",
      "probe_body": "empty",
      "probe_forbidden_headers": ["Authorization", "Idempotency-Key"],
      "probe_discloses_nothing_protected": true,
      "credential_disclosed_only_after": "identity_proof_verified_against_the_projected_pinned_server_identity",
      "one_use": "a_fresh_challenge_per_contact_never_cached_so_a_recorded_probe_answer_authenticates_no_later_contact",
      "second_port": false,
      "second_credential_scheme": false,
      "response": {
        "identity_version": "eliot.opencode.bridge-identity.v1",
        "fields": [
          "identity_version",
          "challenge",
          "installation_id",
          "endpoint",
          "server_identity",
          "introduction_digest",
          "bridge_generation",
          "identity_proof"
        ],
        "closed": true,
        "challenge_must_equal_this_contact": true,
        "server_identity_must_equal_the_projected_pinned_value": true,
        "endpoint_must_equal_the_configured_pinned_endpoint": true
      },
      "identity_proof": {
        "algorithm": "hmac_sha256_hex_rfc2104",
        "key": "introduction_server_identity_bytes",
        "message": "utf8_of_json_array_identity_version_challenge_installation_id_endpoint_server_identity_introduction_digest_bridge_generation",
        "encoders": ["serde_json_value_array", "JSON.stringify_array"]
      }
    },
    "request": {
      "method": "POST",
      "content_type": "application/json",
      "idempotency_header": "Idempotency-Key",
      "idempotency_value": "event_id",
      "maximum_attempts": 2,
      "retry_identity": "same_event_id_and_payload",
      "transient_statuses": [408, 425, 429, 500, 502, 503, 504]
    }
  },
  "serving_side": {
    "process": "eliot-agent-bridge",
    "front_door": "host-events",
    "real_production_construction": true,
    "attach": "ordinary_managed_attach_of_the_bridge_route_launch_path",
    "introduction_projection_env": "ELIOT_OPENCODE_BRIDGE_INTRODUCTION",
    "introduction_projection_fields": ["introduction", "session_facts"],
    "credential_boundary": "user_broker_owned_live_route_credential_table_resolving_the_introductions_own_opaque_handle",
    "listener": "owner_created_exclusively_pre_bound_loopback_socket_on_the_pinned_port__bind_conflict_refuses_the_route",
    "live_owner_state_reproof_per_request": [
      "introduction_issue_expiry_window",
      "live_revocation_set",
      "authority_epoch_against_the_live_attach_fence",
      "state_fence_nonce_against_the_introduction",
      "bridge_generation_against_the_live_attach_generation",
      "pinned_port_against_this_listeners_own_port"
    ],
    "unintroduced_composition": "binds_no_port_and_refuses_closed",
    "durable_decision_reconciliation": "the_routes_own_duplicate_answer_is_the_authority__an_in_process_map_is_only_a_cache",
    "governor_profile": "none_in_this_composition__the_gate_fails_closed_to_a_recorded_observation_and_never_a_permit"
  },
  "legacy_transport": {
    "kind": "bounded_one_shot_process",
    "status": "compatibility_fallback",
    "selection": "only_when_loopback_http_is_not_configured",
    "cross_transport_failover_after_http_attempt": false,
    "environment_policy": "allowlist",
    "timeout_and_stream_limits": true
  },
  "payload": {
    "allowlisted_fields": [
      "event_id",
      "sequence",
      "emitted_at",
      "event_kind",
      "vendor_event_kind",
      "host_session_id",
      "task_id",
      "work_item_id",
      "tool",
      "changed_path",
      "argument_keys",
      "attached_task",
      "effect_descriptor",
      "effect_digest"
    ],
    "forbidden_classes": [
      "prompt_or_message_body",
      "model_output_or_reasoning",
      "tool_argument_values",
      "stdout_or_stderr",
      "command_text",
      "file_or_diff_contents",
      "environment_values",
      "headers_cookies_or_credentials",
      "arbitrary_error_or_stack_payload"
    ]
  },
  "mutation_gate": {
    "applies_when": "attached_task_and_mutating_tool",
    "tool_identity_ref": "tool_identity.mutating_tools",
    "failure_mode": "fail_closed",
    "explicit_allow_decisions": ["allow"],
    "explicit_deny_decision": "deny",
    "legacy_unverified_decisions": ["recorded", "allowed", "pass"],
    "permit_requires": "host_event_response.verified_permit",
    "verified_permit_requires": "preferred_transport.first_contact.identity_proof_verified"
  },
  "host_event_response": {
    "response_version": "eliot.opencode.host-event-response.v1",
    "decisions": {
      "allow": "verified_permit_for_this_exact_effect_only",
      "deny": "verified_owner_refusal_with_closed_reason_code",
      "recorded": "durable_observation_only_never_a_permit"
    },
    "verified_permit": [
      "response_version_is_eliot.opencode.host-event-response.v1",
      "event_id_and_effect_digest_equal_the_gate_request",
      "installation_authority_epoch_and_state_fence_equal_the_projected_bindings",
      "decision_is_allow",
      "expires_at_ms_is_a_future_safe_integer",
      "policy_revision_and_decision_receipt_are_present",
      "response_commitment_verifies"
    ],
    "response_commitment": {
      "algorithm": "hmac_sha256_hex_rfc2104",
      "key": "broker_minted_request_credential_bytes",
      "message": "utf8_of_json_array_response_version_event_id_effect_digest_decision_disposition_reason_code_installation_id_bridge_generation_authority_epoch_state_fence_policy_revision_authority_revision_expires_at_ms_event_receipt_decision_receipt_replayed",
      "field_order": ["response_version", "event_id", "effect_digest", "decision", "disposition", "reason_code", "installation_id", "bridge_generation", "authority_epoch", "state_fence", "policy_revision", "authority_revision", "expires_at_ms", "event_receipt", "decision_receipt", "replayed"],
      "absent_optionals": "null",
      "encoders": ["serde_json_value_array", "JSON.stringify_array"]
    },
    "legacy_ceiling": "a_bare_decision_object_without_response_version_bindings_expiry_and_commitment_is_unverified_and_cannot_authorize_a_mutating_tool",
    "deny_rendering": "locally_rendered_text_from_closed_reason_code_only"
  },
  "tool_identity": {
    "version": "eliot.opencode.tools.v1",
    "classification": "exact_case_sensitive_allowlist_member",
    "mutating_tools": ["bash", "edit", "write", "patch"],
    "read_only_tools": ["read", "grep", "glob", "list", "webfetch", "websearch", "lsp", "codesearch"],
    "unknown_tools": "fail_closed_without_bridge_dispatch"
  },
  "effect_binding": {
    "schema_version": "eliot.opencode.effect.v1",
    "normalization_version": "eliot.opencode.arguments.v1",
    "tool_identity": "exact_case_sensitive_allowlist_member",
    "argument_binding": "bounded_plain_json_values_sorted_by_key_and_tagged_by_type",
    "digest_algorithm": "sha256_hex",
    "raw_values_in_receipt": false,
    "unsupported_values": "fail_closed_without_bridge_dispatch"
  },
  "skipped_tool_receipt": {
    "applies_when": "attached_task_and_exact_read_only_tool",
    "tool_identity_ref": "tool_identity.read_only_tools",
    "decision": "skipped",
    "reason": "read_only_tool",
    "transport": "tool.execute.skipped_through_existing_host_event_bridge",
    "execution_authority": "none"
  },
  "passive_observation": {
    "failure_mode": "degraded_non_blocking",
    "queue": "bounded_serialized",
    "overflow": "drop_with_coalesced_host_warning"
  },
  "proof_ceiling": "Static and Node loopback tests prove client transport selection, first-contact server authentication, bounds, idempotency, payload minimization, fail-closed mutation behavior, and the foreign-listener refusal. They do not prove the server-side durable admission endpoint, current OpenCode hook coverage, Kernel ingress, or a completed AgentAttempt."
}
