{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["instructions/eliot.md"],
  "mcp": {
    "eliot": {
      "type": "local",
      "command": [
        "{env:ELIOT_AGENT_BRIDGE_EXE}",
        "mcp",
        "--profile",
        "SPINE_FUNCTIONAL",
        "--transport",
        "stdio",
        "--client-declaration",
        "{env:ELIOT_AGENT_BRIDGE_DECLARATION}"
      ],
      "enabled": true,
      "timeout": 30000
    }
  }
}
