  "max_field_bytes": 256,
  "max_detail_bytes": 1024,
  "stdout_protocol_contamination": false,
  "allowed_diff": {
    "no_duplicate_evaluation": true,
    "no_lifecycle_delta": true,
    "no_new_visibility": true,
    "no_mutable_global_dedup": true,
    "single_terminal_per_failed_op": true
