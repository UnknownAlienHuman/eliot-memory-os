  "deferred_cases": [
    "1: exact current lib.rs lifecycle/error boundary table and explicit propagated exclusions",
    "2: service-start request versus result",
    "3: startup-ready event only with actual readiness evidence",
    "4: SCM receipt retains control/operation identity",
    "5: unsupported control typed/non-success",
    "6: stop request/pending/stopped distinct",
    "7: activation requested/started/ready/failed distinct",
    "8: drain request/progress/completion distinct",
    "9: managed launch request is not readiness",
    "10: process liveness is not semantic readiness",
    "11: restart versus rollback distinct",
    "12: requested versus terminal cancellation distinct",
    "13: timeout/possible state change remains unknown",
    "14: one terminal error per operation across nested propagation, not one per question mark",
    "15: exact installation/process/generation/operation correlation",
    "16: typed reason/recovery code, no free-text machine status",
    "17: missing evidence suppresses a false success event without changing original semantic behavior",
    "18: sink failure/drop leaves result/order/status/cleanup unchanged",
    "19: credential/env/DB canaries absent",
    "20: SCM/source/user canaries absent",
    "21: injected schedule/capture gives deterministic semantic records, with observational timing separated",
    "22: production-call-path/allowed-diff fixture proves no duplicate evaluation, lifecycle change, new visibility or unowned edit"
  ]
