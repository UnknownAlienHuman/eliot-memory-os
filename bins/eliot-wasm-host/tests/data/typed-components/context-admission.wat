;; ELIOT typed fixture component for the frozen `context-admission` world.
;; Derived from bins/eliot-wasm-host/wit/typed/context-admission.wit: every type, field,
;; case and function below is that world's own WIT surface. Zero imports, exactly
;; one exported interface `eliot:current/admission@0.1.0` exposing `describe` and the world
;; domain function `admit`.
;;
;; Memory map: 0x0000-0x03ff reserved, 0x0400 descriptor strings,
;; 0x0800 the lowered `admit` result tuple, 0x1000, 0x1200, 0x1400 and 0x1600
;; the four echo scratch blocks (each copy is capped at 512 bytes, so they span
;; 0x1000..0x17ff), and 0x1400 the bump region the host `realloc` hands out
;; while lowering the request -- the same 0x1400 as the third scratch block.
(component
  (type $abi_descriptor (record
    (field "world-name" string)
    (field "package-id" string)
    (field "abi-revision" u32)
    (field "native-contract" string)
    (field "native-revision" string)
    (field "abi-digest" string)
  ))
  (type $context_binding (record
    (field "task-id" string)
    (field "attempt-id" string)
    (field "scope-id" string)
    (field "fence-epoch" string)
    (field "fence-generation" u64)
    (field "decision-id" string)
    (field "operation-id" (option string))
  ))
  (type $provider_role (record
    (field "provider" string)
    (field "role" string)
  ))
  (type $loss_policy (enum "non-droppable" "handle-only" "extractive" "summarizable"))
  (type $representation_kind (enum "whole" "handle" "extractive" "summary"))
  (type $atom_representation (record
    (field "kind" $representation_kind)
    (field "content" string)
    (field "manifest" (list string))
    (field "source-digest" string)
    (field "handle" string)
  ))
  (type $measurement_ref (record
    (field "serializer" string)
    (field "schema-revision" string)
    (field "route" string)
    (field "model" string)
    (field "tokenizer" string)
    (field "input-digest" string)
  ))
  (type $privacy_class (enum "open" "restricted" "confidential"))
  (type $authority_class (enum "none" "observer" "proposer"))
  (type $atom_availability (enum "present-current" "missing" "stale" "blocked" "unavailable" "omitted" "exhausted" "unknown" "known-empty" "partial"))
  (type $learning_provenance (record
    (field "campaign-id" string)
    (field "overlay-id" (option string))
    (field "candidate-id" (option string))
    (field "closure-ref" (option string))
    (field "owner" (option string))
    (field "draft" bool)
    (field "expires-at-unix-secs" (option u64))
    (field "permit-digest" string)
  ))
  (type $context_candidate (record
    (field "atom-id" string)
    (field "source-digest" string)
    (field "source-revision" string)
    (field "semantic-role" string)
    (field "provider-role" $provider_role)
    (field "loss-policy" $loss_policy)
    (field "representation" $atom_representation)
    (field "measurement" $measurement_ref)
    (field "privacy" $privacy_class)
    (field "authority" $authority_class)
    (field "availability" $atom_availability)
    (field "dependencies" (list string))
    (field "learning" (option $learning_provenance))
  ))
  (type $capacity_limits (record
    (field "total-capacity" u64)
    (field "fixed-overhead" u64)
    (field "output-reserve" u64)
    (field "review-reserve" u64)
  ))
  (type $decision_revision (record
    (field "decision-id" string)
    (field "recipe-revision" string)
    (field "policy-sha256" string)
  ))
  (type $semantic_role (enum "authority" "goal" "scope" "acceptance" "source" "verifier" "material-unknown" "negative" "security" "evidence" "instruction" "optional" "conflict" "constraint"))
  (type $admission_disposition (enum "include-member" "handle-only" "revalidate" "suppress" "quarantine" "unavailable" "blocked" "over-budget"))
  (type $provider_disposition (record
    (field "slot" $provider_role)
    (field "disposition" $admission_disposition)
  ))
  (type $provider_denominator (record
    (field "requested" (list $provider_role))
    (field "dispositions" (list $provider_disposition))
  ))
  (type $safety_floor_member (record
    (field "atom-id" string)
    (field "role" $semantic_role)
    (field "availability" $atom_availability)
    (field "measurement" (option $measurement_ref))
    (field "required-dependencies" (list string))
  ))
  (type $safety_floor (record
    (field "binding" $context_binding)
    (field "mandatory-atoms" (list string))
    (field "mandatory-roles" (list $semantic_role))
    (field "providers" $provider_denominator)
    (field "members" (list $safety_floor_member))
    (field "interpretation-dependencies" (list string))
    (field "rule-evidence" string)
    (field "capacity" $capacity_limits)
  ))
  (type $safety_floor_identity (record
    (field "floor-id" string)
    (field "decision" $decision_revision)
    (field "floor" $safety_floor)
  ))
  (type $admission_priority_class (enum "protected" "required" "high" "normal" "low"))
  (type $candidate_priority (record
    (field "atom-id" string)
    (field "class" $admission_priority_class)
    (field "ordinal" u32)
  ))
  (type $priority_policy (record
    (field "policy-id" string)
    (field "decision" $decision_revision)
    (field "priorities" (list $candidate_priority))
  ))
  (type $admission_rule (record
    (field "rule-id" string)
    (field "decision" $decision_revision)
    (field "rule-sha256" string)
  ))
  (type $measurement_unit (enum "utf8-bytes" "stu" "tokenizer-tokens"))
  (type $measurement_aggregation (enum "qualified-utf8-contribution" "whole-context-observation"))
  (type $measurement_composition_profile (record
    (field "profile-id" string)
    (field "schema-version" u32)
    (field "serializer-id" string)
    (field "serializer-version" string)
    (field "serializer-options-digest" string)
    (field "route-id" string)
    (field "model-id" string)
    (field "unit" $measurement_unit)
    (field "aggregation" $measurement_aggregation)
    (field "qualification" string)
    (field "capacity" $capacity_limits)
  ))
  (type $expansion_handle (record
    (field "atom-id" string)
    (field "decision-digest" string)
    (field "task-id" string)
    (field "scope-id" string)
    (field "fence-epoch" string)
    (field "source-revision" string)
    (field "handle" string)
    (field "expiry-ms" (option s64))
  ))
  (type $non_recoverable_reason (enum "policy-forbidden" "source-withdrawn" "conflict-unresolvable"))
  (type $supplied_omission_binding (record
    (field "atom-id" string)
    (field "policy" $loss_policy)
    (field "expansion" (option $expansion_handle))
    (field "non-recoverable-reason" (option $non_recoverable_reason))
    (field "authorization-requirement" string)
    (field "privacy-requirement" string)
    (field "proof-requirement" string)
    (field "expires" (option string))
    (field "invalidation" (option string))
  ))
  (type $measurement_status (enum "exact-utf8" "conservative-stu" "exact-tokenizer" "unknown" "unavailable"))
  (type $measurement_binding (record
    (field "context" $context_binding)
    (field "schema-version" u32)
    (field "subject-digest" string)
    (field "input-digest" string)
    (field "output-digest" string)
    (field "serializer-id" string)
    (field "serializer-version" string)
    (field "serializer-options-digest" string)
    (field "route-id" string)
    (field "model-id" string)
  ))
  (type $stu_estimate (record
    (field "value" u64)
    (field "empirical" bool)
  ))
  (type $tokenizer_observation (record
    (field "tokenizer-id" string)
    (field "tokenizer-version" string)
    (field "tokenizer-hash" string)
    (field "tokens" u64)
  ))
  (type $measured_cost (variant
    (case "exact-utf8-bytes" u64)
    (case "conservative-stu" $stu_estimate)
    (case "exact-tokenizer" $tokenizer_observation)
    (case "unknown")
    (case "unavailable")
  ))
  (type $admission_measurement (record
    (field "measurement-id" string)
    (field "atom-id" string)
    (field "representation" $representation_kind)
    (field "unit" $measurement_unit)
    (field "status" $measurement_status)
    (field "binding" $measurement_binding)
    (field "cost" $measured_cost)
    (field "observation" (option $measured_cost))
  ))
  (type $learning_ticket (record
    (field "schema-version" u32)
    (field "source-campaign-id" string)
    (field "target-task-id" string)
    (field "fence-epoch" string)
    (field "fence-generation" u64)
    (field "overlay-id" (option string))
    (field "candidate-id" (option string))
    (field "scope-ref" string)
    (field "authority-ref" string)
    (field "retention-ref" string)
    (field "evaluator-ref" string)
    (field "rollback-ref" string)
    (field "digest" string)
  ))
  (type $admission_request (record
    (field "schema-revision" u32)
    (field "operation-id" string)
    (field "task-id" string)
    (field "attempt-id" string)
    (field "scope-id" string)
    (field "fence-epoch" string)
    (field "fence-generation" u64)
    (field "binding" $context_binding)
    (field "candidates" (list $context_candidate))
    (field "recipe-digest" string)
    (field "recipe-revision" string)
    (field "provider-denominator" (list $provider_role))
    (field "capacity" $capacity_limits)
    (field "floor" $safety_floor_identity)
    (field "priority" $priority_policy)
    (field "rule" $admission_rule)
    (field "measurement-profile" $measurement_composition_profile)
    (field "supplied-omissions" (list $supplied_omission_binding))
    (field "measurements" (list $admission_measurement))
    (field "learning-tickets" (list $learning_ticket))
    (field "deadline-ms" (option s64))
    (field "cancelled" bool)
    (field "predecessor-digest" (option string))
    (field "invalidation" (option string))
  ))
  (type $admitted_atom (record
    (field "atom-id" string)
    (field "representation" $atom_representation)
    (field "measurement" $measurement_ref)
  ))
  (type $omission_reason_kind (enum "over-budget" "policy" "stale-source" "blocked-source" "conflict" "non-recoverable"))
  (type $omission_record (record
    (field "atom-id" string)
    (field "reason" $omission_reason_kind)
    (field "non-recoverable" (option $non_recoverable_reason))
    (field "measured-cost" u64)
    (field "expansion" (option $expansion_handle))
    (field "decision-revision" string)
    (field "policy-revision" string)
    (field "digest" string)
  ))
  (type $economy_allocations (record
    (field "required-allocation" u64)
    (field "optional-allocation" u64)
    (field "headroom" u64)
  ))
  (type $economy_receipt (record
    (field "requested" (list string))
    (field "admitted" (list string))
    (field "displaced" (list string))
    (field "omitted" (list string))
    (field "blocked" (list string))
    (field "applied-rule" string)
    (field "allocations" $economy_allocations)
    (field "capacity" $capacity_limits)
    (field "decision-digest" string)
  ))
  (type $proof_ceiling (enum "observation" "candidate-only" "admission" "assembly" "activation" "screen" "cycle" "handler"))
  (type $admitted_context_set (record
    (field "operation-id" string)
    (field "task-id" string)
    (field "attempt-id" string)
    (field "scope-id" string)
    (field "fence-epoch" string)
    (field "fence-generation" u64)
    (field "recipe-digest" string)
    (field "recipe-revision" string)
    (field "members" (list $admitted_atom))
    (field "dispositions" (list $provider_disposition))
    (field "omissions" (list $omission_record))
    (field "economy" $economy_receipt)
    (field "frontier" (list string))
    (field "proof-ceiling" $proof_ceiling)
    (field "canonical-digest" string)
  ))
  (type $decision_incomplete_code (enum "decision-context-incomplete"))
  (type $provider_gap (record
    (field "slot" $provider_role)
    (field "state" $atom_availability)
  ))
  (type $decision_incomplete (record
    (field "code" $decision_incomplete_code)
    (field "missing" (list string))
    (field "stale" (list string))
    (field "blocked" (list string))
    (field "unavailable" (list string))
    (field "omitted" (list string))
    (field "exhausted" (list string))
    (field "unknown" (list string))
    (field "known-empty" (list string))
    (field "partial" (list string))
    (field "provider-gaps" (list $provider_gap))
    (field "oversized" (list string))
    (field "failed-floor-rule" string)
    (field "measurements" (list string))
    (field "reopening-requirements" (list string))
    (field "proof-ceiling" $proof_ceiling)
  ))
  (type $admission_result (variant
    (case "admitted" $admitted_context_set)
    (case "incomplete" $decision_incomplete)
  ))
  (type $admission_malformed (record
    (field "field" string)
    (field "human-detail" string)
  ))
  (type $admission_denominator (record
    (field "human-detail" string)
  ))
  (type $admission_fence (record
    (field "human-detail" string)
  ))
  (type $admission_capacity (record
    (field "human-detail" string)
  ))
  (type $admission_unknown_measurement (record
    (field "human-detail" string)
  ))
  (type $admission_omission (record
    (field "human-detail" string)
  ))
  (type $admission_economy (record
    (field "human-detail" string)
  ))
  (type $admission_schema (record
    (field "want-revision" u32)
    (field "got-revision" u32)
    (field "human-detail" string)
  ))
  (type $admission_internal (record
    (field "human-detail" string)
  ))
  (type $admission_error (variant
    (case "malformed" $admission_malformed)
    (case "denominator-mismatch" $admission_denominator)
    (case "stale-fence" $admission_fence)
    (case "capacity-exceeded" $admission_capacity)
    (case "unknown-measurement" $admission_unknown_measurement)
    (case "omission-handle-invalid" $admission_omission)
    (case "economy-mismatch" $admission_economy)
    (case "unsupported-schema" $admission_schema)
    (case "internal" $admission_internal)
  ))
  (type $f-describe (func (result $abi_descriptor)))
  (type $f-domain (func (param "request" $admission_request) (result (result $admission_result (error $admission_error)))))
  (core module $guest
    (memory (export "memory") 1 1)
    (global $bump (mut i32) (i32.const 5120))
    (func $copy (param $dst i32) (param $src i32) (param $len i32)
      (local $i i32)
      (block $done
        (loop $next
          (br_if $done (i32.ge_u (local.get $i) (local.get $len)))
          (i32.store8 (i32.add (local.get $dst) (local.get $i)) (i32.load8_u (i32.add (local.get $src) (local.get $i))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $next))))
    (func $realloc (param $old i32) (param $old_size i32) (param $align i32) (param $new_size i32) (result i32)
      (local $ptr i32)
      (local.set $ptr (global.get $bump))
      (local.set $ptr (i32.and (i32.add (local.get $ptr) (i32.sub (local.get $align) (i32.const 1)))
                 (i32.xor (local.get $align) (i32.const -1))))
      (global.set $bump (i32.add (local.get $ptr) (local.get $new_size)))
      (local.get $ptr))
    ;; `describe`: the frozen WIT abi-descriptor, five static strings and
    ;; the frozen ABI revision, in WIT field order. A lifted export flattens
    ;; its result to at most MAX_FLAT_FUNC_RESULTS = 1 core value, so the
    ;; core function returns ONE pointer into exported linear memory
    ;; (wasmparser-0.252.0 src/validator/component_types.rs:36, :130 and
    ;; :1261-1274, enforced at src/validator/component.rs:1328 and :1350).
    ;; Retptr base 0x600: past the last descriptor byte at 0x480 and below
    ;; the 0x800 result tuple, so it collides with nothing in this memory.
    (func (export "describe") (result i32)
      ;; world-name
      (i32.store (i32.const 1536) (i32.const 1024))
      (i32.store (i32.const 1540) (i32.const 17))
      ;; package-id
      (i32.store (i32.const 1544) (i32.const 1041))
      (i32.store (i32.const 1548) (i32.const 19))
      ;; abi-revision
      (i32.store (i32.const 1552) (i32.const 1))
      ;; native-contract
      (i32.store (i32.const 1556) (i32.const 1060))
      (i32.store (i32.const 1560) (i32.const 23))
      ;; native-revision
      (i32.store (i32.const 1564) (i32.const 1083))
      (i32.store (i32.const 1568) (i32.const 5))
      ;; abi-digest
      (i32.store (i32.const 1572) (i32.const 1088))
      (i32.store (i32.const 1576) (i32.const 64))
      (i32.const 1536))
    ;; `admit`: the admitted typed request arrives already lowered into guest
    ;; memory. The closed WIT result tuple is written in full and every
    ;; identity field is copied back out of the request, so the host echo
    ;; check compares values the guest actually read.
    (func (export "admit") (param $req i32) (result i32)
      (local $n i32)
      ;; result ok case: the WIT success variant
      (i32.store (i32.const 2048) (i32.const 0))
      ;; variant "admission-result" selects WIT case "admitted"
      (i32.store (i32.const 2056) (i32.const 0))
      ;; echo "operation-id" back out of the lowered request
      (local.set $n (i32.load (i32.add (local.get $req) (i32.const 8))))
      (if (i32.gt_u (local.get $n) (i32.const 512)) (then (local.set $n (i32.const 512))))
      (call $copy (i32.const 4096) (i32.load (i32.add (local.get $req) (i32.const 4))) (local.get $n))
      (i32.store (i32.const 2064) (i32.const 4096))
      (i32.store (i32.const 2068) (local.get $n))
      ;; echo "task-id" back out of the lowered request
      (local.set $n (i32.load (i32.add (local.get $req) (i32.const 16))))
      (if (i32.gt_u (local.get $n) (i32.const 512)) (then (local.set $n (i32.const 512))))
      (call $copy (i32.const 4608) (i32.load (i32.add (local.get $req) (i32.const 12))) (local.get $n))
      (i32.store (i32.const 2072) (i32.const 4608))
      (i32.store (i32.const 2076) (local.get $n))
      ;; echo "scope-id" back out of the lowered request
      (local.set $n (i32.load (i32.add (local.get $req) (i32.const 32))))
      (if (i32.gt_u (local.get $n) (i32.const 512)) (then (local.set $n (i32.const 512))))
      (call $copy (i32.const 5120) (i32.load (i32.add (local.get $req) (i32.const 28))) (local.get $n))
      (i32.store (i32.const 2088) (i32.const 5120))
      (i32.store (i32.const 2092) (local.get $n))
      ;; echo "fence-epoch" back out of the lowered request
      (local.set $n (i32.load (i32.add (local.get $req) (i32.const 40))))
      (if (i32.gt_u (local.get $n) (i32.const 512)) (then (local.set $n (i32.const 512))))
      (call $copy (i32.const 5632) (i32.load (i32.add (local.get $req) (i32.const 36))) (local.get $n))
      (i32.store (i32.const 2096) (i32.const 5632))
      (i32.store (i32.const 2100) (local.get $n))
      (i32.const 2048))
    (export "realloc" (func $realloc))
    (data (i32.const 1024) "context-admission")
    (data (i32.const 1041) "eliot:current@0.1.0")
    (data (i32.const 1060) "eliot-context-admission")
    (data (i32.const 1083) "0.1.0")
    (data (i32.const 1088) "6e878cbb40e2060fd2d570345a1b0105920a0398b3c70e2c4e1f9b7eb291a0e6")
  )
  (core instance $guest (instantiate $guest))
  (alias core export $guest "memory" (core memory $memory))
  (alias core export $guest "realloc" (core func $realloc))
  (alias core export $guest "describe" (core func $describe))
  (alias core export $guest "admit" (core func $domain))
  (func $describe (type $f-describe)
    (canon lift (core func $describe) (memory $memory) (realloc $realloc)))
  (func $domain (type $f-domain)
    (canon lift (core func $domain) (memory $memory) (realloc $realloc)))
  (instance $iface
    (export "describe" (func $describe))
    (export "admit" (func $domain)))
  (export "eliot:current/admission@0.1.0" (instance $iface))
)
