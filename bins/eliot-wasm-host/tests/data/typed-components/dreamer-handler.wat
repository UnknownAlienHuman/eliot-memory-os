;; ELIOT typed fixture component for the frozen `dreamer-handler` world.
;; Derived from bins/eliot-wasm-host/wit/typed/dreamer-handler.wit: every type, field,
;; case and function below is that world's own WIT surface. Zero imports, exactly
;; one exported interface `eliot:current/handler@0.1.0` exposing `describe` and the world
;; domain function `handle`.
;;
;; Memory map: 0x0000-0x03ff reserved, 0x0400 descriptor strings,
;; 0x0800 the lowered `handle` result tuple, 0x1000 echo scratch, 0x1400 the bump
;; region the host `realloc` hands out while lowering the request.
(component
  (type $abi_descriptor (record
    (field "world-name" string)
    (field "package-id" string)
    (field "abi-revision" u32)
    (field "native-contract" string)
    (field "native-revision" string)
    (field "abi-digest" string)
  ))
  (type $job_class (enum "orientation" "curation" "clarification" "research-synthesis" "architecture-self-query" "development-diagnosis" "maintenance" "orchestration-planning" "configuration-assistance"))
  (type $requester_origin (enum "human" "admitted-agent" "schedule-policy"))
  (type $requester (record
    (field "principal" string)
    (field "origin" $requester_origin)
    (field "session" string)
  ))
  (type $orientation_payload (record
    (field "summary" string)
    (field "findings" (list string))
    (field "unknowns" (list string))
  ))
  (type $evidence_grade (enum "e0" "e1" "e2" "e3"))
  (type $source_authority (enum "authoritative" "competent" "limited" "unknown"))
  (type $freshness (enum "fresh" "stale" "unknown"))
  (type $source_card (record
    (field "handle" string)
    (field "grade" $evidence_grade)
    (field "authority" $source_authority)
    (field "freshness" $freshness)
    (field "competence" string)
    (field "privacy-class" string)
    (field "allowed-use" string)
    (field "lineage-group" string)
    (field "transformed" bool)
  ))
  (type $denominator_kind (enum "complete-scope" "sampled" "unknown"))
  (type $counter_search_status (enum "complete" "partial" "not-run"))
  (type $omitted_source (record
    (field "handle" string)
    (field "reason" string)
  ))
  (type $research_pack_ref (record
    (field "pack-digest" string)
    (field "question" string)
    (field "task-id" string)
    (field "scope-id" string)
    (field "fence-epoch" string)
    (field "fence-generation" u64)
    (field "bundle-digest" string)
    (field "manifest-digest" string)
    (field "sources" (list $source_card))
    (field "source-denominator" (list string))
    (field "coverage-denominator" $denominator_kind)
    (field "counter-search" $counter_search_status)
    (field "missing-source-classes" (list string))
    (field "omitted-sources" (list $omitted_source))
    (field "authorized-sources" (list string))
  ))
  (type $claim_kind (enum "factual" "numeric" "time" "version" "causal" "absence"))
  (type $claim_disposition (enum "supported" "contested" "unsupported" "outside-manifest" "precision-limited" "absent-scope-complete" "absent-scope-incomplete" "duplicate-collapsed" "withheld"))
  (type $research_claim (record
    (field "claim-id" string)
    (field "is-counterclaim" bool)
    (field "kind" $claim_kind)
    (field "disposition" $claim_disposition)
    (field "support" (list string))
    (field "counter-evidence" (list string))
    (field "citations" (list string))
    (field "weakest-grade" $evidence_grade)
    (field "authority" $source_authority)
    (field "lineage-groups" (list string))
    (field "precision-notes" (list string))
    (field "absence-basis" string)
  ))
  (type $rival_stance (enum "supports" "opposes" "alternative"))
  (type $rival_position (record
    (field "rival-id" string)
    (field "position" string)
    (field "stance" $rival_stance)
    (field "target-claim" string)
    (field "minority" bool)
    (field "evidence" (list string))
    (field "weakest-grade" $evidence_grade)
  ))
  (type $recommended_probe (record
    (field "probe-id" string)
    (field "discriminates" (list string))
    (field "outcomes" (list string))
    (field "verifier" string)
    (field "owner" string)
    (field "cost-class" string)
    (field "applicability" string)
  ))
  (type $probe_residue_reason (enum "nondiscriminative" "unknown-target" "unauthorized" "budget"))
  (type $probe_residue (record
    (field "probe-id" string)
    (field "reason" $probe_residue_reason)
    (field "detail" string)
  ))
  (type $concilium_recommendation (record
    (field "owner" string)
    (field "evidence-refs" (list string))
    (field "positions" (list string))
    (field "review-objective" string)
    (field "effect-count" u64)
    (field "suppressed" bool)
  ))
  (type $coverage_report (record
    (field "denominator" $denominator_kind)
    (field "counter-search" $counter_search_status)
    (field "missing-classes" (list string))
    (field "omitted-sources" (list $omitted_source))
    (field "represented-sources" (list string))
    (field "cited-sources" (list string))
  ))
  (type $dependence_group (record
    (field "lineage-group" string)
    (field "members" (list string))
    (field "independent-roots" u64)
    (field "unknown" bool)
  ))
  (type $candidate_disposition (enum "candidate" "duplicate" "conflict" "abstention" "partial" "blocked" "unsupported" "internal-defect"))
  (type $brief_preservation_dimension (enum "coverage" "preservation" "faithfulness" "lineage" "reversibility" "source-authority" "dependency-closure"))
  (type $preservation_verdict (record
    (field "dimension" $brief_preservation_dimension)
    (field "passed" bool)
    (field "known" bool)
    (field "note" string)
  ))
  (type $omission_kind (enum "claims" "rivals" "references" "probes" "unknowns" "work" "output-bytes" "concilium"))
  (type $brief_omission (record
    (field "kind" $omission_kind)
    (field "detail" string)
    (field "denominator" u64)
    (field "omitted" u64)
  ))
  (type $research_brief (record
    (field "brief-id" string)
    (field "pack" $research_pack_ref)
    (field "pack-digest" string)
    (field "question" string)
    (field "claims" (list $research_claim))
    (field "rivals" (list $rival_position))
    (field "unknowns" (list string))
    (field "probes" (list $recommended_probe))
    (field "probe-residue" (list $probe_residue))
    (field "concilium" $concilium_recommendation)
    (field "coverage" $coverage_report)
    (field "dependence" (list $dependence_group))
    (field "disposition" $candidate_disposition)
    (field "preservation" (list $preservation_verdict))
    (field "omitted" (list $brief_omission))
    (field "raw-digest" string)
    (field "semantic-digest" string)
  ))
  (type $research_payload (record
    (field "pack" $research_pack_ref)
    (field "brief" $research_brief)
  ))
  (type $curation_family (enum "classification" "relation" "episode" "concept" "procedure" "failure" "structure-repair" "reconsolidation" "accessibility" "memory-repair"))
  (type $curation_kind (enum "classification" "relation" "episode" "concept" "procedure" "failure" "merge" "split" "reconsolidation" "accessibility" "repair"))
  (type $classification_payload (record
    (field "label" string)
    (field "confidence-bps" u32)
    (field "targets" (list string))
    (field "evidence-refs" (list string))
  ))
  (type $relation_payload (record
    (field "from-handle" string)
    (field "to-handle" string)
    (field "predicate" string)
    (field "evidence-refs" (list string))
  ))
  (type $generic_curation_payload (record
    (field "kind" $curation_kind)
    (field "targets" (list string))
    (field "evidence-refs" (list string))
    (field "note" string)
  ))
  (type $curation_payload (variant
    (case "classification" $classification_payload)
    (case "relation" $relation_payload)
    (case "generic" $generic_curation_payload)
  ))
  (type $curation_request_ref (record
    (field "family" $curation_family)
    (field "kinds" (list $curation_kind))
    (field "handler-id" string)
    (field "registry-digest" string)
    (field "payload" $curation_payload)
  ))
  (type $unsupported_subtype (record
    (field "want-kind" string)
    (field "human-detail" string)
  ))
  (type $handler_subtype (variant
    (case "orientation" $orientation_payload)
    (case "research-synthesis" $research_payload)
    (case "curation" $curation_request_ref)
    (case "unsupported" $unsupported_subtype)
  ))
  (type $budget_limits (record
    (field "max-input-bytes" u32)
    (field "max-output-bytes" u32)
    (field "max-candidates" u16)
    (field "max-work" u64)
    (field "max-depth" u8)
  ))
  (type $preservation_dimension (enum "coverage" "faithfulness" "lineage" "reversibility" "authority-ceiling" "dependency-closure" "provenance-retention"))
  (type $dimension_verdict (record
    (field "dimension" $preservation_dimension)
    (field "passed" bool)
    (field "known" bool)
    (field "note" string)
  ))
  (type $preservation_report (record
    (field "verdicts" (list $dimension_verdict))
  ))
  (type $validated_candidate (record
    (field "schema-revision" u32)
    (field "operation-id" string)
    (field "job" $job_class)
    (field "requester" $requester)
    (field "task-id" string)
    (field "attempt-id" string)
    (field "scope-id" string)
    (field "fence-epoch" string)
    (field "fence-generation" u64)
    (field "bundle-digest" string)
    (field "manifest-digest" string)
    (field "grounding-digest" string)
    (field "validation-receipt" string)
    (field "subtype" $handler_subtype)
    (field "budget" $budget_limits)
    (field "preservation" $preservation_report)
    (field "deadline-ms" (option s64))
    (field "cancelled" bool)
  ))
  (type $proof_ceiling (enum "observation" "candidate-only" "admission" "assembly" "activation" "screen" "cycle" "handler"))
  (type $handler_result_body (record
    (field "operation-id" string)
    (field "job" $job_class)
    (field "subtype" $handler_subtype)
    (field "disposition" $candidate_disposition)
    (field "preservation" $preservation_report)
    (field "output-digest" string)
    (field "proof-ceiling" $proof_ceiling)
    (field "frontier" (list string))
  ))
  (type $handler_outcome (variant
    (case "handled" $handler_result_body)
  ))
  (type $handler_malformed (record
    (field "field" string)
    (field "human-detail" string)
  ))
  (type $handler_kind (record
    (field "want-kind" string)
    (field "got-kind" string)
    (field "human-detail" string)
  ))
  (type $handler_unsupported (record
    (field "want-kind" string)
    (field "human-detail" string)
  ))
  (type $handler_budget (record
    (field "human-detail" string)
  ))
  (type $handler_schema (record
    (field "want-revision" u32)
    (field "got-revision" u32)
    (field "human-detail" string)
  ))
  (type $handler_internal (record
    (field "human-detail" string)
  ))
  (type $handler_error (variant
    (case "malformed" $handler_malformed)
    (case "kind-mismatch" $handler_kind)
    (case "unsupported-subtype-error" $handler_unsupported)
    (case "budget-exceeded" $handler_budget)
    (case "unsupported-schema" $handler_schema)
    (case "internal" $handler_internal)
  ))
  (type $f-describe (func (result $abi_descriptor)))
  (type $f-domain (func (param "candidate" $validated_candidate) (result (result $handler_outcome (error $handler_error)))))
  (core module $guest
    (memory (export "memory") 1 1)
    (global $bump (mut i32) (i32.const 5120))
    (func $copy (param $dst i32) (param $src i32) (param $len i32)
      (local $i i32)
      (block $done
        (loop $next
          (br_if $done (i32.ge_u (local.get $i) (local.get $len)))
          (i32.store8 (i32.add (local.get $dst) (local.get $i)) (i32.load8_u (i32.add (local.get $src) (local.get $i))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $next))))
    (func $realloc (param $old i32) (param $old_size i32) (param $align i32) (param $new_size i32) (result i32)
      (local $ptr i32)
      (local.set $ptr (global.get $bump))
      (local.set $ptr (i32.and (i32.add (local.get $ptr) (i32.sub (local.get $align) (i32.const 1)))
                 (i32.xor (local.get $align) (i32.const -1))))
      (global.set $bump (i32.add (local.get $ptr) (local.get $new_size)))
      (local.get $ptr))
    ;; `describe`: the frozen WIT abi-descriptor, five static strings and
    ;; the frozen ABI revision, in WIT field order. A lifted export flattens
    ;; its result to at most MAX_FLAT_FUNC_RESULTS = 1 core value, so the
    ;; core function returns ONE pointer into exported linear memory
    ;; (wasmparser-0.256.0 src/validator/component_types.rs:35, :129 and
    ;; :1279-1292, enforced at src/validator/component.rs:1343 and :1365).
    ;; Retptr base 0x600: past the last descriptor byte at 0x47e and below
    ;; the 0x800 result tuple, so it collides with nothing in this memory.
    (func (export "describe") (result i32)
      ;; world-name
      (i32.store (i32.const 1536) (i32.const 1024))
      (i32.store (i32.const 1540) (i32.const 15))
      ;; package-id
      (i32.store (i32.const 1544) (i32.const 1039))
      (i32.store (i32.const 1548) (i32.const 19))
      ;; abi-revision
      (i32.store (i32.const 1552) (i32.const 1))
      ;; native-contract
      (i32.store (i32.const 1556) (i32.const 1058))
      (i32.store (i32.const 1560) (i32.const 23))
      ;; native-revision
      (i32.store (i32.const 1564) (i32.const 1081))
      (i32.store (i32.const 1568) (i32.const 5))
      ;; abi-digest
      (i32.store (i32.const 1572) (i32.const 1086))
      (i32.store (i32.const 1576) (i32.const 64))
      (i32.const 1536))
    ;; `handle`: the admitted typed request arrives already lowered into guest
    ;; memory. The closed WIT result tuple is written in full and every
    ;; identity field is copied back out of the request, so the host echo
    ;; check compares values the guest actually read.
    (func (export "handle") (param $req i32) (result i32)
      (local $n i32)
      ;; result ok case: the WIT success variant
      (i32.store (i32.const 2048) (i32.const 0))
      ;; variant "handler-outcome" selects WIT case "handled"
      (i32.store (i32.const 2056) (i32.const 0))
      ;; echo "operation-id" back out of the lowered request
      (local.set $n (i32.load (i32.add (local.get $req) (i32.const 8))))
      (if (i32.gt_u (local.get $n) (i32.const 512)) (then (local.set $n (i32.const 512))))
      (call $copy (i32.const 4096) (i32.load (i32.add (local.get $req) (i32.const 4))) (local.get $n))
      (i32.store (i32.const 2064) (i32.const 4096))
      (i32.store (i32.const 2068) (local.get $n))
      (i32.const 2048))
    (export "realloc" (func $realloc))
    (data (i32.const 1024) "dreamer-handler")
    (data (i32.const 1039) "eliot:current@0.1.0")
    (data (i32.const 1058) "eliot-dreamer-contracts")
    (data (i32.const 1081) "0.1.0")
    (data (i32.const 1086) "6e878cbb40e2060fd2d570345a1b0105920a0398b3c70e2c4e1f9b7eb291a0e6")
  )
  (core instance $guest (instantiate $guest))
  (alias core export $guest "memory" (core memory $memory))
  (alias core export $guest "realloc" (core func $realloc))
  (alias core export $guest "describe" (core func $describe))
  (alias core export $guest "handle" (core func $domain))
  (func $describe (type $f-describe)
    (canon lift (core func $describe) (memory $memory) (realloc $realloc)))
  (func $domain (type $f-domain)
    (canon lift (core func $domain) (memory $memory) (realloc $realloc)))
  (instance $iface
    (export "describe" (func $describe))
    (export "handle" (func $domain)))
  (export "eliot:current/handler@0.1.0" (instance $iface))
)
