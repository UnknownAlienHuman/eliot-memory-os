# Rust / build output
target/
dist/
**/bin/
**/obj/

# Rust binary source modules are source, not build output
!crates/**/src/bin/
!crates/**/src/bin/**

# Runtime and machine-local state
.eliot/
.eliot-dev/
.eliot-governor/
**/.eliot-governor/
.codebase-memory/
logs/
reports/
runtime/

# Investigation/donor material and retired swarm state
/research/
/swarm/
/*_PROGRESS.md

# Environment and credentials
.env
.env.*
!.env.example
!.env.*.example
.npmrc
.pypirc
.netrc
credentials.json
**/credentials.json
*.pem
*.key
*.p12
*.pfx
*.kdbx
id_rsa
id_ed25519

# Developer-local agent/tool state
# .cargo/config.toml carries a machine-specific external build-cache path.
.cargo/config.toml
.claude/settings.local.json
.codex/config.toml
.codex/config.local.toml
.codex/cargo_metadata.json
history.txt

# Local databases / WAL / crash files
*.redb
*.wal
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.dmp
*.core

# Python bytecode and caches
__pycache__/
*.py[cod]

# Common temporary files
*.tmp
*.temp
*.bak
*.swp

# Excluded capability cells are standalone workspace roots (see the `exclude`
# comment in the root Cargo.toml), so cargo writes a lock file next to each one.
# The same applies to any other crate that declares its own `[workspace]`.
# Those locks are build artifacts of an unadmitted crate, never release inputs.
crates/*/*/Cargo.lock
# Issue #1229 A1: the nine adjacent locks below are the checked-in resolver
# join inputs the dependency-policy verifier binds offline
# (bind_nonmember_resolver_identity); they are verification evidence, never
# release inputs, and any substitution breaks the preparation-lock binding.
!crates/research/eliot-dreamer-source-assurance/Cargo.lock
!crates/smart/eliot-context-compiler-wasm/Cargo.lock
!crates/smart/eliot-cue-activation-wasm/Cargo.lock
!crates/smart/eliot-dreamer-curation-wasm/Cargo.lock
!crates/smart/eliot-dreamer-cycle-wasm/Cargo.lock
!crates/smart/eliot-dreamer-orientation-wasm/Cargo.lock
!crates/smart/eliot-dreamer-research-wasm/Cargo.lock
!crates/smart/eliot-memory-applicability/Cargo.lock
!crates/smart/eliot-memory-curation-screen-wasm/Cargo.lock

# Per-item build/verification evidence written by swarm managers. Never committed.
items/
