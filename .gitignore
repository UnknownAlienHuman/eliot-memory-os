# Rust / build output
target/
dist/
**/bin/
**/obj/

# Rust binary source modules are source, not build output
!crates/**/src/bin/
!crates/**/src/bin/**

# Runtime and machine-local state
.eliot/
.eliot-dev/
.eliot-governor/
**/.eliot-governor/
.codebase-memory/
logs/
reports/
runtime/

# Investigation/donor material and retired swarm state
/research/
/swarm/
/*_PROGRESS.md

# Environment and credentials
.env
.env.*
!.env.example
!.env.*.example
.npmrc
.pypirc
.netrc
credentials.json
**/credentials.json
*.pem
*.key
*.p12
*.pfx
*.kdbx
id_rsa
id_ed25519

# Developer-local agent/tool state
# .cargo/config.toml carries a machine-specific external build-cache path.
.cargo/config.toml
.claude/settings.local.json
.codex/config.toml
.codex/config.local.toml
.codex/cargo_metadata.json
history.txt

# Local databases / WAL / crash files
*.redb
*.wal
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.dmp
*.core

# Python bytecode and caches
__pycache__/
*.py[cod]

# Common temporary files
*.tmp
*.temp
*.bak
*.swp

# Excluded capability cells are standalone workspace roots (see the `exclude`
# comment in the root Cargo.toml), so cargo writes a lock file next to each one.
# Those locks are build artifacts of an unadmitted cell, never release inputs.
crates/*/*/Cargo.lock
