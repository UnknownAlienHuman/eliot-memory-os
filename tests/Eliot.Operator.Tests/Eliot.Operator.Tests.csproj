<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../apps/Eliot.Operator/Protocol/OperatorContracts.cs" Link="Protocol/OperatorContracts.cs" />
    <Compile Include="../../apps/Eliot.Operator/Protocol/OperatorIntent.cs" Link="Protocol/OperatorIntent.cs" />
    <Compile Include="../../apps/Eliot.Operator/Protocol/OperatorJsonGuard.cs" Link="Protocol/OperatorJsonGuard.cs" />
    <Compile Include="../../apps/Eliot.Operator/Protocol/OperatorDiagnostics.cs" Link="Protocol/OperatorDiagnostics.cs" />
    <Compile Include="../../apps/Eliot.Operator/Protocol/OperatorHandoff.cs" Link="Protocol/OperatorHandoff.cs" />
    <Compile Include="../../apps/Eliot.Operator/Protocol/OperatorResponseBounds.cs" Link="Protocol/OperatorResponseBounds.cs" />
    <Compile Include="../../apps/Eliot.Operator/Protocol/UserAutomationContracts.cs" Link="Protocol/UserAutomationContracts.cs" />
    <!--
      Minimum compile closure for the file above. `UserAutomationContracts.cs`
      opens with `using Eliot.Operator.Protocol.Generated;` and names
      `UserAutomationScheduleReceipt`, so the linked harness did not compile on
      main without these two production sources. No assertion, case or SDK was
      added: these entries only make the already-committed harness source
      compile so the locked build gate can run at all.
    -->
    <Compile Include="../../apps/Eliot.Operator/Protocol/UserAutomationScheduleContract.cs" Link="Protocol/UserAutomationScheduleContract.cs" />
    <Compile Include="../../apps/Eliot.Operator/Protocol/Generated/OperatorScheduleContract.g.cs" Link="Protocol/Generated/OperatorScheduleContract.g.cs" />
    <Compile Include="../../apps/Eliot.Operator/Services/IGovernorClient.cs" Link="Services/IGovernorClient.cs" />
    <Compile Include="../../apps/Eliot.Operator/Services/OperatorClientFaults.cs" Link="Services/OperatorClientFaults.cs" />
    <Compile Include="../../apps/Eliot.Operator/Services/OperatorProcessIdentityProvider.cs" Link="Services/OperatorProcessIdentityProvider.cs" />
    <Compile Include="../../apps/Eliot.Operator/Services/OperatorPendingOperationJournal.cs" Link="Services/OperatorPendingOperationJournal.cs" />
    <Compile Include="../../apps/Eliot.Operator/Services/BrokerPipeClient.cs" Link="Services/BrokerPipeClient.cs" />
    <Compile Include="../../apps/Eliot.Operator/Services/GovernorPipeClient.cs" Link="Services/GovernorPipeClient.cs" />
    <!--
      Minimum compile closure for the file above. `GovernorPipeClient.cs` now
      resolves the ControlBoard/Operator IPC pipe through
      `ControlBoardPipeLocator.ReadPipeName` instead of the broker handoff name,
      so the linked harness did not compile on that commit without this
      production source. No assertion, case or SDK was added: this entry only
      makes the already-committed harness source compile so the locked build
      gate can run at all.
    -->
    <Compile Include="../../apps/Eliot.Operator/Services/ControlBoardPipeLocator.cs" Link="Services/ControlBoardPipeLocator.cs" />
    <Compile Include="../../apps/Eliot.Operator/Services/RuntimeDiscoveryService.cs" Link="Services/RuntimeDiscoveryService.cs" />
    <Compile Include="../../apps/Eliot.Operator/ViewModels/MainViewModel.cs" Link="ViewModels/MainViewModel.cs" />
    <None Include="../../crates/eliot-types/schema/operator-contract-v1.json" Link="operator-contract-v1.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
