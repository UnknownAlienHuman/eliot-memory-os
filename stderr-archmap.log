import sys, re, collections
lines=[l.rstrip('\n') for l in sys.stdin]
hard=[l for l in lines if l.startswith('HARD_VIOLATION:')]
sig=[l for l in lines if l.startswith('AUDIT_SIGNAL:')]
print(f'TOTAL_LINES={len(lines)} HARD={len(hard)} SIG={len(sig)}')
for l in lines[:1]:
    print(l)
# group by issue
pat=re.compile(r'issue=#(\d+)')
def key(l):
    m=pat.search(l)
    return '#'+m.group(1) if m else '(no issue)'
from collections import Counter, defaultdict
c=Counter(key(l) for l in hard+sig)
print(c)
# per issue files
import re
files=defaultdict(set)
rules=defaultdict(set)
for l in hard+sig:
    k=key(l)
    m=re.search(r'HARD_VIOLATION:\s*(\S+):\s*(\S+)',l)
    m2=re.search(r'AUDIT_SIGNAL:\s*(\S+):\s*(\S+)',l)
    m=m or m2
    if m:
        rules[k].add(m.group(1))
        files[k].add(m.group(2))
for k in sorted(files, key=lambda x:(x=='(no issue)',x)):
    print(f'{k} count={c[k]} rules={sorted(rules[k])} files={len(files[k])}')
"

