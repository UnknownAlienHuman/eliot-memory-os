{
  "contract": "eliot.foundation.protocol.durable-job",
  "states": [
    "NOT_STARTED",
    "QUEUED",
    "LEASED",
    "RUNNING",
    "CHECKPOINTED",
    "VERIFYING",
    "COMPLETED",
    "PARTIAL",
    "FAILED",
    "CANCELLED",
    "UNKNOWN_OUTCOME"
  ],
  "terminal": [
    "COMPLETED",
    "PARTIAL",
    "FAILED",
    "CANCELLED",
    "UNKNOWN_OUTCOME"
  ],
  "legal_edges": [
