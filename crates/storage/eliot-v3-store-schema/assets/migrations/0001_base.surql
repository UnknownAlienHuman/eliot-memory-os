-- Eliot Memory OS V3 Base schema for SurrealDB 3.3.4.
-- Runtime qualification of this exact bundle remains owned by Slice 0.

DEFINE TABLE stream TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD stream_id ON TABLE stream TYPE string READONLY ASSERT $value = /^s_[0-7][0-9A-HJKMNP-TV-Z]{25}$/ PERMISSIONS NONE;
DEFINE FIELD project ON TABLE stream TYPE string READONLY ASSERT string::len($value) > 0 AND string::len($value) <= 256 PERMISSIONS NONE;
DEFINE FIELD source_kind ON TABLE stream TYPE string READONLY ASSERT string::len($value) > 0 AND string::len($value) <= 96 PERMISSIONS NONE;
DEFINE FIELD source_native_id ON TABLE stream TYPE string READONLY ASSERT string::len($value) > 0 AND string::len($value) <= 512 PERMISSIONS NONE;
DEFINE FIELD workspace_id ON TABLE stream TYPE option<string> READONLY ASSERT $value = NONE OR string::len($value) <= 256 PERMISSIONS NONE;
DEFINE FIELD stream_unique_key ON TABLE stream TYPE string READONLY ASSERT $value = /^[0-9a-f]{64}$/ PERMISSIONS NONE;
DEFINE FIELD last_ingest_seq ON TABLE stream TYPE int ASSERT $value >= 0 PERMISSIONS NONE;
DEFINE FIELD created_at_ms ON TABLE stream TYPE int READONLY ASSERT $value >= 0 PERMISSIONS NONE;
DEFINE FIELD updated_at_ms ON TABLE stream TYPE int ASSERT $value >= $this.created_at_ms PERMISSIONS NONE;
DEFINE INDEX stream_id_unique ON TABLE stream FIELDS stream_id UNIQUE;
DEFINE INDEX stream_identity_unique ON TABLE stream FIELDS stream_unique_key UNIQUE;

DEFINE TABLE observation TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD observation_id ON TABLE observation TYPE string READONLY ASSERT $value = /^o_[0-7][0-9A-HJKMNP-TV-Z]{25}$/ PERMISSIONS NONE;
DEFINE FIELD project ON TABLE observation TYPE string READONLY ASSERT string::len($value) > 0 AND string::len($value) <= 256 PERMISSIONS NONE;
DEFINE FIELD stream_id ON TABLE observation TYPE string READONLY ASSERT $value = /^s_[0-7][0-9A-HJKMNP-TV-Z]{25}$/ PERMISSIONS NONE;
DEFINE FIELD event_key ON TABLE observation TYPE string READONLY ASSERT string::len($value) > 0 AND string::len($value) <= 512 PERMISSIONS NONE;
DEFINE FIELD command_id ON TABLE observation TYPE option<string> READONLY ASSERT $value = NONE OR string::len($value) <= 512 PERMISSIONS NONE;
DEFINE FIELD native_event_key ON TABLE observation TYPE option<string> READONLY ASSERT $value = NONE OR string::len($value) <= 512 PERMISSIONS NONE;
DEFINE FIELD ingest_seq ON TABLE observation TYPE int READONLY ASSERT $value > 0 PERMISSIONS NONE;
DEFINE FIELD occurrence_time_ms ON TABLE observation TYPE option<int> READONLY ASSERT $value = NONE OR $value >= 0 PERMISSIONS NONE;
DEFINE FIELD occurrence_precision ON TABLE observation TYPE string READONLY ASSERT $value = "exact" OR $value = "approximate" OR $value = "unknown" PERMISSIONS NONE;
DEFINE FIELD receipt_time_ms ON TABLE observation TYPE int READONLY ASSERT $value >= 0 PERMISSIONS NONE;
DEFINE FIELD kind ON TABLE observation TYPE string READONLY ASSERT string::len($value) > 0 AND string::len($value) <= 96 PERMISSIONS NONE;
DEFINE FIELD body_storage ON TABLE observation TYPE string READONLY ASSERT (($value = "inline") AND ($this.body_inline != NONE) AND ($this.blob_ref = NONE)) OR (($value = "blob") AND ($this.body_inline = NONE) AND ($this.blob_ref != NONE)) PERMISSIONS NONE;
DEFINE FIELD body_inline ON TABLE observation TYPE option<string> READONLY ASSERT $value = NONE OR string::len($value) <= 65536 PERMISSIONS NONE;
DEFINE FIELD blob_ref ON TABLE observation TYPE option<string> READONLY ASSERT $value = NONE OR string::len($value) <= 512 PERMISSIONS NONE;
DEFINE FIELD body_length ON TABLE observation TYPE int READONLY ASSERT $value >= 0 PERMISSIONS NONE;
DEFINE FIELD body_sha256 ON TABLE observation TYPE string READONLY ASSERT $value = /^[0-9a-f]{64}$/ PERMISSIONS NONE;
DEFINE FIELD search_excerpt ON TABLE observation TYPE string READONLY ASSERT string::len($value) <= 8192 PERMISSIONS NONE;
DEFINE FIELD disclosure ON TABLE observation TYPE string READONLY ASSERT $value = "local_only" OR $value = "external_allowed" PERMISSIONS NONE;
DEFINE FIELD workspace_id ON TABLE observation TYPE option<string> READONLY ASSERT $value = NONE OR string::len($value) <= 256 PERMISSIONS NONE;
DEFINE FIELD task_id ON TABLE observation TYPE option<string> READONLY ASSERT $value = NONE OR string::len($value) <= 256 PERMISSIONS NONE;
DEFINE FIELD actor_id ON TABLE observation TYPE option<string> READONLY ASSERT $value = NONE OR string::len($value) <= 256 PERMISSIONS NONE;
DEFINE FIELD session_id ON TABLE observation TYPE option<string> READONLY ASSERT $value = NONE OR string::len($value) <= 256 PERMISSIONS NONE;
DEFINE FIELD call_id ON TABLE observation TYPE option<string> READONLY ASSERT $value = NONE OR string::len($value) <= 256 PERMISSIONS NONE;
DEFINE FIELD parent_observation_id ON TABLE observation TYPE option<string> READONLY ASSERT $value = NONE OR $value = /^o_[0-7][0-9A-HJKMNP-TV-Z]{25}$/ PERMISSIONS NONE;
DEFINE FIELD resource_id ON TABLE observation TYPE option<string> READONLY ASSERT $value = NONE OR string::len($value) <= 512 PERMISSIONS NONE;
DEFINE FIELD resource_version ON TABLE observation TYPE option<string> READONLY ASSERT $value = NONE OR string::len($value) <= 512 PERMISSIONS NONE;
DEFINE FIELD locator_json ON TABLE observation TYPE string READONLY ASSERT string::len($value) <= 16384 PERMISSIONS NONE;
DEFINE FIELD binding_json ON TABLE observation TYPE string READONLY ASSERT string::len($value) <= 16384 PERMISSIONS NONE;
DEFINE FIELD relations_json ON TABLE observation TYPE string READONLY ASSERT string::len($value) <= 32768 PERMISSIONS NONE;
DEFINE FIELD capture_limit_json ON TABLE observation TYPE string READONLY ASSERT string::len($value) <= 8192 PERMISSIONS NONE;
DEFINE FIELD created_at_ms ON TABLE observation TYPE int READONLY ASSERT $value >= 0 PERMISSIONS NONE;
DEFINE INDEX observation_id_unique ON TABLE observation FIELDS observation_id UNIQUE;
DEFINE INDEX observation_event_unique ON TABLE observation FIELDS project, stream_id, event_key UNIQUE;
DEFINE INDEX observation_command_unique ON TABLE observation FIELDS project, command_id UNIQUE;
DEFINE INDEX observation_stream_order ON TABLE observation FIELDS stream_id, ingest_seq, observation_id;
DEFINE INDEX observation_task_continuation ON TABLE observation FIELDS project, workspace_id, task_id, receipt_time_ms, observation_id;
DEFINE INDEX observation_session_continuation ON TABLE observation FIELDS project, workspace_id, actor_id, session_id, receipt_time_ms, observation_id;

DEFINE TABLE memory TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD memory_id ON TABLE memory TYPE string READONLY ASSERT $value = /^m_[0-7][0-9A-HJKMNP-TV-Z]{25}$/ PERMISSIONS NONE;
DEFINE FIELD origin_project ON TABLE memory TYPE string READONLY ASSERT string::len($value) > 0 AND string::len($value) <= 256 PERMISSIONS NONE;
DEFINE FIELD reuse_scope ON TABLE memory TYPE string ASSERT $value = "origin" OR $value = "selected" OR $value = "owner_projects" PERMISSIONS NONE;
DEFINE FIELD revision ON TABLE memory TYPE int ASSERT $value > 0 PERMISSIONS NONE;
DEFINE FIELD kind ON TABLE memory TYPE string ASSERT string::len($value) > 0 AND string::len($value) <= 96 PERMISSIONS NONE;
DEFINE FIELD address_kind ON TABLE memory TYPE option<string> ASSERT $value = NONE OR string::len($value) <= 96 PERMISSIONS NONE;
DEFINE FIELD address_key ON TABLE memory TYPE option<string> ASSERT $value = NONE OR string::len($value) <= 512 PERMISSIONS NONE;
DEFINE FIELD address_unique_key ON TABLE memory TYPE option<string> ASSERT (($value = NONE) AND ($this.address_kind = NONE) AND ($this.address_key = NONE)) OR (($value != NONE) AND ($value = /^[0-9a-f]{64}$/) AND ($this.address_kind != NONE) AND ($this.address_key != NONE)) PERMISSIONS NONE;
DEFINE FIELD content ON TABLE memory TYPE string ASSERT string::len($value) <= 262144 PERMISSIONS NONE;
DEFINE FIELD search_text ON TABLE memory TYPE string ASSERT string::len($value) <= 32768 PERMISSIONS NONE;
DEFINE FIELD exact_cues ON TABLE memory TYPE array<string> ASSERT array::len($value) <= 128 PERMISSIONS NONE;
DEFINE FIELD disclosure ON TABLE memory TYPE string ASSERT $value = "local_only" OR $value = "external_allowed" PERMISSIONS NONE;
DEFINE FIELD subject ON TABLE memory TYPE option<string> ASSERT $value = NONE OR string::len($value) <= 512 PERMISSIONS NONE;
DEFINE FIELD aspect ON TABLE memory TYPE option<string> ASSERT $value = NONE OR string::len($value) <= 256 PERMISSIONS NONE;
DEFINE FIELD perspective ON TABLE memory TYPE option<string> ASSERT $value = NONE OR string::len($value) <= 256 PERMISSIONS NONE;
DEFINE FIELD conditions_json ON TABLE memory TYPE string ASSERT string::len($value) <= 32768 PERMISSIONS NONE;
DEFINE FIELD exceptions_json ON TABLE memory TYPE string ASSERT string::len($value) <= 32768 PERMISSIONS NONE;
DEFINE FIELD valid_from_ms ON TABLE memory TYPE option<int> ASSERT $value = NONE OR $value >= 0 PERMISSIONS NONE;
DEFINE FIELD valid_until_ms ON TABLE memory TYPE option<int> ASSERT $value = NONE OR (($value >= 0) AND ($this.valid_from_ms = NONE OR $this.valid_from_ms <= $value)) PERMISSIONS NONE;
DEFINE FIELD support_state ON TABLE memory TYPE string ASSERT $value = "unknown" OR $value = "supported" OR $value = "contested" OR $value = "refuted" PERMISSIONS NONE;
DEFINE FIELD exposure_state ON TABLE memory TYPE string ASSERT $value = "normal" OR $value = "reduced" OR $value = "hidden" PERMISSIONS NONE;
DEFINE FIELD influence_state ON TABLE memory TYPE string ASSERT $value = "advisory" OR $value = "withdrawn" OR $value = "superseded" PERMISSIONS NONE;
DEFINE FIELD commitment_state ON TABLE memory TYPE option<string> ASSERT $value = NONE OR $value = "open" OR $value = "resolved" OR $value = "cancelled" PERMISSIONS NONE;
DEFINE FIELD method_role ON TABLE memory TYPE option<string> ASSERT $value = NONE OR $value = "advice" OR $value = "processing" PERMISSIONS NONE;
DEFINE FIELD processing_purpose ON TABLE memory TYPE option<string> ASSERT $value = NONE OR string::len($value) <= 128 PERMISSIONS NONE;
DEFINE FIELD created_at_ms ON TABLE memory TYPE int READONLY ASSERT $value >= 0 PERMISSIONS NONE;
DEFINE FIELD updated_at_ms ON TABLE memory TYPE int ASSERT $value >= $this.created_at_ms PERMISSIONS NONE;
DEFINE INDEX memory_id_unique ON TABLE memory FIELDS memory_id UNIQUE;
DEFINE INDEX memory_address_unique ON TABLE memory FIELDS address_unique_key UNIQUE;
DEFINE INDEX memory_project_kind ON TABLE memory FIELDS origin_project, kind, memory_id;

DEFINE TABLE memory_history TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD history_id ON TABLE memory_history TYPE string READONLY ASSERT $value = /^h_[0-7][0-9A-HJKMNP-TV-Z]{25}$/ PERMISSIONS NONE;
DEFINE FIELD memory_id ON TABLE memory_history TYPE string READONLY ASSERT $value = /^m_[0-7][0-9A-HJKMNP-TV-Z]{25}$/ PERMISSIONS NONE;
DEFINE FIELD revision ON TABLE memory_history TYPE int READONLY ASSERT $value > 0 PERMISSIONS NONE;
DEFINE FIELD snapshot_json ON TABLE memory_history TYPE string READONLY ASSERT string::len($value) <= 393216 PERMISSIONS NONE;
DEFINE FIELD replaced_at_ms ON TABLE memory_history TYPE int READONLY ASSERT $value >= 0 PERMISSIONS NONE;
DEFINE INDEX memory_history_id_unique ON TABLE memory_history FIELDS history_id UNIQUE;
DEFINE INDEX memory_history_revision_unique ON TABLE memory_history FIELDS memory_id, revision UNIQUE;

DEFINE TABLE link TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD link_id ON TABLE link TYPE string READONLY ASSERT $value = /^l_[0-7][0-9A-HJKMNP-TV-Z]{25}$/ PERMISSIONS NONE;
DEFINE FIELD source_kind ON TABLE link TYPE string READONLY ASSERT string::len($value) > 0 AND string::len($value) <= 64 PERMISSIONS NONE;
DEFINE FIELD source_id ON TABLE link TYPE string READONLY ASSERT string::len($value) > 0 AND string::len($value) <= 128 PERMISSIONS NONE;
DEFINE FIELD source_revision ON TABLE link TYPE option<int> READONLY ASSERT $value = NONE OR $value > 0 PERMISSIONS NONE;
DEFINE FIELD target_kind ON TABLE link TYPE string READONLY ASSERT string::len($value) > 0 AND string::len($value) <= 64 PERMISSIONS NONE;
DEFINE FIELD target_id ON TABLE link TYPE string READONLY ASSERT string::len($value) > 0 AND string::len($value) <= 128 PERMISSIONS NONE;
DEFINE FIELD target_revision ON TABLE link TYPE option<int> READONLY ASSERT $value = NONE OR $value > 0 PERMISSIONS NONE;
DEFINE FIELD relation_kind ON TABLE link TYPE string READONLY ASSERT string::len($value) > 0 AND string::len($value) <= 96 PERMISSIONS NONE;
DEFINE FIELD grounds_group ON TABLE link TYPE option<string> READONLY ASSERT $value = NONE OR string::len($value) <= 128 PERMISSIONS NONE;
DEFINE FIELD locator_json ON TABLE link TYPE string READONLY ASSERT string::len($value) <= 16384 PERMISSIONS NONE;
DEFINE FIELD qualification_json ON TABLE link TYPE string READONLY ASSERT string::len($value) <= 16384 PERMISSIONS NONE;
DEFINE FIELD created_at_ms ON TABLE link TYPE int READONLY ASSERT $value >= 0 PERMISSIONS NONE;
DEFINE INDEX link_id_unique ON TABLE link FIELDS link_id UNIQUE;
DEFINE INDEX link_forward ON TABLE link FIELDS source_kind, source_id, source_revision, relation_kind, link_id;
DEFINE INDEX link_reverse ON TABLE link FIELDS target_kind, target_id, target_revision, relation_kind, link_id;

DEFINE TABLE job TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD job_id ON TABLE job TYPE string READONLY ASSERT $value = /^j_[0-7][0-9A-HJKMNP-TV-Z]{25}$/ PERMISSIONS NONE;
DEFINE FIELD project ON TABLE job TYPE string READONLY ASSERT string::len($value) > 0 AND string::len($value) <= 256 PERMISSIONS NONE;
DEFINE FIELD purpose ON TABLE job TYPE string READONLY ASSERT string::len($value) > 0 AND string::len($value) <= 128 PERMISSIONS NONE;
DEFINE FIELD target_key ON TABLE job TYPE string READONLY ASSERT string::len($value) > 0 AND string::len($value) <= 512 PERMISSIONS NONE;
DEFINE FIELD state ON TABLE job TYPE string ASSERT $value = "pending" OR $value = "claimed" OR $value = "running" OR $value = "waiting" OR $value = "succeeded" OR $value = "failed" OR $value = "cancelled" PERMISSIONS NONE;
DEFINE FIELD slot_key ON TABLE job TYPE option<string> ASSERT (($this.state = "pending") AND ($value != NONE) AND ($value = /^[0-9a-f]{64}$/)) OR ((($this.state = "claimed") OR ($this.state = "running") OR ($this.state = "waiting")) AND ($value != NONE) AND ($value = /^[0-9a-f]{64}$/)) OR ((($this.state = "succeeded") OR ($this.state = "failed") OR ($this.state = "cancelled")) AND ($value = NONE)) PERMISSIONS NONE;
DEFINE FIELD origin ON TABLE job TYPE string READONLY ASSERT $value = "explicit" OR $value = "automatic" OR $value = "maintenance" PERMISSIONS NONE;
DEFINE FIELD cause_id ON TABLE job TYPE option<string> READONLY ASSERT $value = NONE OR string::len($value) <= 512 PERMISSIONS NONE;
DEFINE FIELD first_queued_at_ms ON TABLE job TYPE int READONLY ASSERT $value >= 0 PERMISSIONS NONE;
DEFINE FIELD due_at_ms ON TABLE job TYPE option<int> ASSERT $value = NONE OR $value >= 0 PERMISSIONS NONE;
DEFINE FIELD attempt ON TABLE job TYPE int ASSERT $value >= 0 PERMISSIONS NONE;
DEFINE FIELD waiting_reason ON TABLE job TYPE option<string> ASSERT $value = NONE OR string::len($value) <= 512 PERMISSIONS NONE;
DEFINE FIELD claim_owner ON TABLE job TYPE option<string> ASSERT ($value = NONE) = ($this.claim_until_ms = NONE) PERMISSIONS NONE;
DEFINE FIELD claim_until_ms ON TABLE job TYPE option<int> ASSERT ($value = NONE) = ($this.claim_owner = NONE) PERMISSIONS NONE;
DEFINE FIELD frozen_input_json ON TABLE job TYPE string READONLY ASSERT string::len($value) <= 262144 PERMISSIONS NONE;
DEFINE FIELD method_id ON TABLE job TYPE option<string> READONLY ASSERT $value = NONE OR $value = /^m_[0-7][0-9A-HJKMNP-TV-Z]{25}$/ PERMISSIONS NONE;
DEFINE FIELD method_revision ON TABLE job TYPE option<int> READONLY ASSERT $value = NONE OR $value > 0 PERMISSIONS NONE;
DEFINE FIELD limits_json ON TABLE job TYPE string READONLY ASSERT string::len($value) <= 16384 PERMISSIONS NONE;
DEFINE FIELD disclosure ON TABLE job TYPE string READONLY ASSERT $value = "local_only" OR $value = "external_allowed" PERMISSIONS NONE;
DEFINE FIELD profile_name ON TABLE job TYPE option<string> READONLY ASSERT $value = NONE OR string::len($value) <= 128 PERMISSIONS NONE;
DEFINE FIELD request_blob_ref ON TABLE job TYPE option<string> ASSERT (($value = NONE) AND ($this.request_length = NONE) AND ($this.request_sha256 = NONE)) OR (($value != NONE) AND ($this.request_length != NONE) AND ($this.request_sha256 != NONE)) PERMISSIONS NONE;
DEFINE FIELD request_length ON TABLE job TYPE option<int> ASSERT $value = NONE OR $value >= 0 PERMISSIONS NONE;
DEFINE FIELD request_sha256 ON TABLE job TYPE option<string> ASSERT $value = NONE OR $value = /^[0-9a-f]{64}$/ PERMISSIONS NONE;
DEFINE FIELD result_json ON TABLE job TYPE string ASSERT string::len($value) <= 262144 PERMISSIONS NONE;
DEFINE FIELD coverage_json ON TABLE job TYPE string ASSERT string::len($value) <= 65536 PERMISSIONS NONE;
DEFINE FIELD cleanup_json ON TABLE job TYPE string ASSERT string::len($value) <= 65536 PERMISSIONS NONE;
DEFINE FIELD created_at_ms ON TABLE job TYPE int READONLY ASSERT $value >= 0 PERMISSIONS NONE;
DEFINE FIELD updated_at_ms ON TABLE job TYPE int ASSERT $value >= $this.created_at_ms PERMISSIONS NONE;
DEFINE INDEX job_id_unique ON TABLE job FIELDS job_id UNIQUE;
DEFINE INDEX job_slot_unique ON TABLE job FIELDS slot_key UNIQUE;
DEFINE INDEX job_due ON TABLE job FIELDS state, due_at_ms, first_queued_at_ms, job_id;
DEFINE INDEX job_target ON TABLE job FIELDS project, purpose, target_key, state, job_id;

DEFINE ANALYZER eliot_base_text TOKENIZERS blank,class FILTERS lowercase;
DEFINE INDEX observation_search ON TABLE observation FIELDS search_excerpt FULLTEXT ANALYZER eliot_base_text BM25;
DEFINE INDEX memory_search ON TABLE memory FIELDS search_text FULLTEXT ANALYZER eliot_base_text BM25;
