{
  "mcpServers": {
    "eliot": {
      "type": "stdio",
      "command": "bin/eliot-agent-bridge.exe",
      "cwd": ".",
      "args": [
        "mcp",
        "--profile",
        "codex_controller",
        "--transport",
        "stdio",
        "--client-declaration",
        "${PLUGIN_ROOT}/bin/agent-bridge/client-declaration-v2.json"
      ],
      "enabled": true,
      "required": false
    }
  }
}
