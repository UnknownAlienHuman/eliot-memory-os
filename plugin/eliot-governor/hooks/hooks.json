{
  "description": "Secondary lifecycle bridge. Hooks deliver prepared context, enforce existing gates, and record observations; model-owned memory writes remain MCP calls.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}\\bin\\eliot-agent-bridge.exe\" mcp --profile codex_controller --transport stdio --client-declaration \"${PLUGIN_ROOT}\\bin\\agent-bridge\\client-declaration-v2.json\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}\\bin\\eliot-agent-bridge.exe\" mcp --profile codex_controller --transport stdio --client-declaration \"${PLUGIN_ROOT}\\bin\\agent-bridge\\client-declaration-v2.json\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}\\bin\\eliot-agent-bridge.exe\" mcp --profile codex_controller --transport stdio --client-declaration \"${PLUGIN_ROOT}\\bin\\agent-bridge\\client-declaration-v2.json\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}\\bin\\eliot-agent-bridge.exe\" mcp --profile codex_controller --transport stdio --client-declaration \"${PLUGIN_ROOT}\\bin\\agent-bridge\\client-declaration-v2.json\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}\\bin\\eliot-agent-bridge.exe\" mcp --profile codex_controller --transport stdio --client-declaration \"${PLUGIN_ROOT}\\bin\\agent-bridge\\client-declaration-v2.json\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}\\bin\\eliot-agent-bridge.exe\" mcp --profile codex_controller --transport stdio --client-declaration \"${PLUGIN_ROOT}\\bin\\agent-bridge\\client-declaration-v2.json\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
