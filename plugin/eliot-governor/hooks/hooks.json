{
  "description": "Secondary lifecycle bridge. Hooks deliver prepared context, enforce existing gates, and record observations; model-owned memory writes remain MCP calls.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "eliot-governor.exe",
            "args": [
              "hook",
              "session-start"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "eliot-governor.exe",
            "args": [
              "hook",
              "pre-tool-use"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "eliot-governor.exe",
            "args": [
              "hook",
              "post-tool-use"
            ],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "eliot-governor.exe",
            "args": [
              "hook",
              "pre-compact"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "eliot-governor.exe",
            "args": [
              "hook",
              "post-compact"
            ],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "eliot-governor.exe",
            "args": [
              "hook",
              "stop"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
