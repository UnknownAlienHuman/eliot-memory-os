{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/eliot-governor\" hook session-start",
            "commandWindows": "\"%PLUGIN_ROOT%\\bin\\eliot-governor.exe\" hook session-start",
            "statusMessage": "ELIOT session context",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/eliot-governor\" hook user-prompt-submit",
            "commandWindows": "\"%PLUGIN_ROOT%\\bin\\eliot-governor.exe\" hook user-prompt-submit",
            "statusMessage": "ELIOT task candidate",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/eliot-governor\" hook subagent-start",
            "commandWindows": "\"%PLUGIN_ROOT%\\bin\\eliot-governor.exe\" hook subagent-start",
            "statusMessage": "ELIOT bounded subagent start",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/eliot-governor\" hook pre-tool-use",
            "commandWindows": "\"%PLUGIN_ROOT%\\bin\\eliot-governor.exe\" hook pre-tool-use",
            "statusMessage": "ELIOT tool gate",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/eliot-governor\" hook permission-request",
            "commandWindows": "\"%PLUGIN_ROOT%\\bin\\eliot-governor.exe\" hook permission-request",
            "statusMessage": "ELIOT permission gate",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/eliot-governor\" hook post-tool-use",
            "commandWindows": "\"%PLUGIN_ROOT%\\bin\\eliot-governor.exe\" hook post-tool-use",
            "statusMessage": "ELIOT tool observation",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/eliot-governor\" hook pre-compact",
            "commandWindows": "\"%PLUGIN_ROOT%\\bin\\eliot-governor.exe\" hook pre-compact",
            "statusMessage": "ELIOT compact gate",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/eliot-governor\" hook post-compact",
            "commandWindows": "\"%PLUGIN_ROOT%\\bin\\eliot-governor.exe\" hook post-compact",
            "statusMessage": "ELIOT compact context",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/eliot-governor\" hook subagent-stop",
            "commandWindows": "\"%PLUGIN_ROOT%\\bin\\eliot-governor.exe\" hook subagent-stop",
            "statusMessage": "ELIOT bounded subagent stop",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/eliot-governor\" hook stop",
            "commandWindows": "\"%PLUGIN_ROOT%\\bin\\eliot-governor.exe\" hook stop",
            "statusMessage": "ELIOT completion gate",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
