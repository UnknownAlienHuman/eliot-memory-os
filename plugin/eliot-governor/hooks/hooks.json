{
  "description": "Secondary lifecycle bridge. Hooks deliver prepared context, enforce existing gates, and record observations; model-owned memory writes remain MCP calls.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}\\bin\\eliot-governor.exe\" hook session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}\\bin\\eliot-governor.exe\" hook pre-tool-use",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}\\bin\\eliot-governor.exe\" hook post-tool-use",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}\\bin\\eliot-governor.exe\" hook pre-compact",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}\\bin\\eliot-governor.exe\" hook post-compact",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}\\bin\\eliot-governor.exe\" hook stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
