<Window
    x:Class="Eliot.Operator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ELIOT Operator">

    <NavigationView x:Name="Navigation"
                    DataContext="{x:Bind ViewModel}"
                    SelectionChanged="Navigation_OnSelectionChanged"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    PaneDisplayMode="Auto"
                    OpenPaneLength="280">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Overview" Tag="overview" Icon="Home" />
            <NavigationViewItem Content="Tasks and Work" Tag="tasks_work" Icon="AllApps" />
            <NavigationViewItem Content="Task Cognition" Tag="task_cognition" Icon="Bullets" />
            <NavigationViewItem Content="Memory Explorer" Tag="memory_explorer" Icon="Library" />
            <NavigationViewItem Content="Causal and Provenance" Tag="causal_provenance" />
            <NavigationViewItem Content="Schema and Contracts" Tag="schema_contracts" />
            <NavigationViewItem Content="Query and Inspection Lab" Tag="query_lab" />
            <NavigationViewItem Content="Experience and Skills" Tag="experience_skills" />
            <NavigationViewItem Content="Sleep and Meta Lab" Tag="sleep_meta" />
            <NavigationViewItem Content="Agents and Routing" Tag="agents_routing" Icon="People" />
            <NavigationViewItem Content="Autonomy Runs" Tag="autonomy" Icon="Play" />
            <NavigationViewItem Content="Approvals" Tag="approvals" Icon="Permissions" />
            <NavigationViewItem Content="Timeline, Incidents and Operations" Tag="timeline_operations" Icon="Clock" />
        </NavigationView.MenuItems>

        <Grid Padding="20" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <InfoBar x:Name="StatusBanner" Grid.Row="0"
                     IsOpen="True"
                     IsClosable="False"
                     Title="{Binding StatusTitle}"
                     Message="{Binding StatusMessage}"
                     AutomationProperties.LiveSetting="Polite" />

            <Grid Grid.Row="1" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox x:Name="CommandPalette"
                                Grid.Column="0"
                                Header="Command palette (Ctrl+K)"
                                PlaceholderText="Go to a page, refresh, cancel, or load more"
                                ItemsSource="{Binding PaletteSuggestions}"
                                QuerySubmitted="CommandPalette_OnQuerySubmitted"
                                AutomationProperties.Name="Operator command palette">
                    <AutoSuggestBox.KeyboardAccelerators>
                        <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="CommandPaletteAccelerator_OnInvoked" />
                    </AutoSuggestBox.KeyboardAccelerators>
                </AutoSuggestBox>
                <Button Grid.Column="1" Content="Refresh" Click="Refresh_OnClick" VerticalAlignment="Bottom" AccessKey="R"
                        AutomationProperties.Name="Refresh current Governor projection" />
                <Button Grid.Column="2" Content="Cancel request" Click="Cancel_OnClick" VerticalAlignment="Bottom"
                        AutomationProperties.Name="Cancel active Governor request" />
                <ProgressRing Grid.Column="3" IsActive="{Binding IsBusy}" Width="28" Height="28" VerticalAlignment="Bottom"
                              AutomationProperties.Name="Governor request progress" />
            </Grid>

            <Expander Grid.Row="2" Header="Scope, filters and saved views" IsExpanded="True">
                <Grid Padding="0,10,0,0" ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="ProjectIdTextBox" Grid.Column="0" Header="Project ID" PlaceholderText="UUID"
                             Text="{Binding ProjectId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Canonical project ID" />
                    <TextBox x:Name="TaskIdTextBox" Grid.Column="1" Header="Task ID" PlaceholderText="UUID"
                             Text="{Binding TaskId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Canonical task ID" />
                    <TextBox Grid.Column="2" Header="Search" PlaceholderText="Title, handle, evidence or field"
                             Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="3" Header="Kind" Text="{Binding KindFilter, Mode=TwoWay}" />
                    <TextBox Grid.Column="4" Header="Status" Text="{Binding StatusFilter, Mode=TwoWay}" />
                    <TextBox Grid.Column="5" Header="Authority" Text="{Binding AuthorityFilter, Mode=TwoWay}" />
                    <Button Grid.Column="6" Content="Apply" Click="ApplyFilter_OnClick" VerticalAlignment="Bottom" />

                    <ComboBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Header="Saved filters"
                              ItemsSource="{Binding SavedFilters}" SelectedItem="{Binding SelectedSavedFilter, Mode=TwoWay}"
                              DisplayMemberPath="Name" />
                    <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                        <Button Content="Save current" Click="SaveFilter_OnClick" />
                        <Button Content="Apply saved" Click="ApplySavedFilter_OnClick" />
                        <Button Content="Clear filters" Click="ClearFilter_OnClick" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="5" Grid.ColumnSpan="2" Text="{Binding ResultSummary}"
                               TextWrapping="Wrap" VerticalAlignment="Bottom" />
                </Grid>
            </Expander>

            <Expander x:Name="QueryLabPanel" Grid.Row="3" Header="Typed Query Lab execution" Visibility="Collapsed">
                <Grid Padding="0,10,0,0" ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ComboBox Grid.Column="0" Header="Closed operation" ItemsSource="{Binding QueryOperations}"
                              SelectedItem="{Binding QueryOperation, Mode=TwoWay}"
                              AutomationProperties.Name="Typed Query Lab operation" />
                    <TextBox Grid.Column="1" Header="Parameters JSON" Text="{Binding QueryParametersText, Mode=TwoWay}"
                             AutomationProperties.Name="Typed Query Lab parameters" />
                    <ComboBox Grid.Column="2" Header="Result mode" ItemsSource="{Binding ResultModes}"
                              SelectedItem="{Binding ResultMode, Mode=TwoWay}"
                              AutomationProperties.Name="Query result mode" />
                    <NumberBox Grid.Column="3" Header="Graph depth" Minimum="1" Maximum="3"
                               Value="{Binding GraphDepth, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                    <Button Grid.Column="4" Content="Execute query" Click="ExecuteQuery_OnClick" VerticalAlignment="Bottom"
                            AutomationProperties.Name="Execute bounded typed query" />
                    <TextBox Grid.Row="1" Grid.ColumnSpan="5" Header="JSON result" Text="{Binding ResultPayloadText}"
                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="150"
                             AutomationProperties.Name="Copyable typed query JSON result" />
                </Grid>
            </Expander>

            <Grid Grid.Row="4" ColumnSpacing="14" MinHeight="300">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="360" />
                    <ColumnDefinition Width="*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding SectionTitle}" Style="{StaticResource TitleTextBlockStyle}" />
                            <InfoBadge Value="{Binding ItemCount}" />
                        </StackPanel>
                        <TextBlock Text="{Binding SectionDescription}" TextWrapping="Wrap" Opacity="0.8" />
                    </StackPanel>

                    <Canvas x:Name="GraphCanvas" Grid.Row="1" Height="230" Visibility="Collapsed"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            AutomationProperties.Name="Bounded causal and provenance graph" />

                    <ListView x:Name="ProjectionList"
                              Grid.Row="2"
                              ItemsSource="{Binding Records}"
                              SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                              SelectionChanged="ProjectionList_OnSelectionChanged"
                              IsItemClickEnabled="False"
                              TabNavigation="Cycle"
                              AutomationProperties.Name="Paged Governor projection records">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8" ColumnSpacing="10" AutomationProperties.Name="{Binding AccessibleSummary}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Opacity="0.78" />
                                        <TextBlock Text="{Binding RecordRef}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding RecordKind}" FontSize="12" />
                                        <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Grid.Row="3" Content="Load next page" Click="LoadMore_OnClick" IsEnabled="{Binding CanLoadMore}"
                            HorizontalAlignment="Center" AutomationProperties.Name="Load next bounded result page" />
                </Grid>

                <Border Grid.Column="1" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Record detail" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{Binding SelectedRecord.Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedRecord.Summary}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedRecord.RecordRef}" FontFamily="Consolas" TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True" AutomationProperties.Name="Copyable record reference" />

                            <TextBlock Text="Fields" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding SelectedRecord.Fields}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="8" Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Relationships" FontWeight="SemiBold" />
                            <ListView ItemsSource="{Binding SelectedRecord.Relationships}" MaxHeight="180"
                                      AutomationProperties.Name="Record provenance relationships">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2">
                                            <TextBlock TextWrapping="Wrap">
                                                <Run Text="{Binding Relation}" FontWeight="SemiBold" /><Run Text=" → " /><Run Text="{Binding TargetRef}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding EvidenceSummary}" FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <TextBlock Text="{Binding ObservedSummary}" FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock Text="Governed action" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding SelectedRecord.Actions}"
                                      SelectedItem="{Binding SelectedAction, Mode=TwoWay}"
                                      SelectionChanged="Action_OnSelectionChanged"
                                      DisplayMemberPath="Label"
                                      AutomationProperties.Name="Typed governed actions" />
                            <ComboBox x:Name="CandidateDispositionBox" Header="Candidate disposition" Visibility="Collapsed"
                                      ItemsSource="{Binding CandidateDispositions}"
                                      SelectedItem="{Binding CandidateDisposition, Mode=TwoWay}"
                                      AutomationProperties.Name="Candidate disposition" />
                            <TextBox Header="Reason or exact evidence/source reference"
                                     Text="{Binding ActionInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="56" />
                            <Button Content="Submit typed action" Click="ExecuteAction_OnClick"
                                    AutomationProperties.Name="Submit selected typed action through Governor" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <StackPanel x:Name="RunControls" Grid.Row="5" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                <Button Content="Start run" Click="Start_OnClick" />
                <Button Content="Pause run" Click="Pause_OnClick" />
                <Button Content="Resume run" Click="Resume_OnClick" />
                <Button Content="Cancel run" Click="CancelRun_OnClick" />
                <TextBlock Text="All durable mutations require typed Governor acceptance and a canonical receipt." VerticalAlignment="Center" Opacity="0.75" />
            </StackPanel>
        </Grid>
    </NavigationView>
</Window>
