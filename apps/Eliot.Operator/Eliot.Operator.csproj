<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Eliot.Operator</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
  </ItemGroup>

  <Target Name="CopyGeneratedWinUiResourcesToPublishDirectory" AfterTargets="Publish">
    <ItemGroup>
      <_GeneratedWinUiXbf Include="$(TargetDir)**\*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pri"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(TargetDir)$(AssemblyName).pri')" />
    <Copy SourceFiles="@(_GeneratedWinUiXbf)"
          DestinationFiles="@(_GeneratedWinUiXbf->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    Narrow cross-language contract parity gate (#2865).

    The C# Operator mirrors the Kernel UserAutomation schedule/occurrence
    contract. The mirror constants, the closed disposition vocabulary, the owner
    refusal Display strings and the byte shape of every owner grammar function
    the mirror reimplements are GENERATED by
    scripts/gen_operator_schedule_contract.py from
    crates/kernel/eliot-kernel-core/src/user_automation.rs and
    user_automation_zones.rs. This target runs that generator in check mode
    before CoreCompile, so a Rust contract/schema change, or a hand edit of the
    generated mirror, fails `dotnet build` until the mirror is regenerated and
    reviewed, instead of failing later at runtime on one machine.

    Disclosure: this makes the C# build require `python` on PATH. Set
    OperatorScheduleContractCheck=false to skip the gate for a bounded local
    compile; the committed `just operator-check` recipe does not skip it, and a
    skipped build is not evidence of contract parity.
  -->
  <PropertyGroup>
    <OperatorScheduleContractCheck Condition="'$(OperatorScheduleContractCheck)' == ''">true</OperatorScheduleContractCheck>
  </PropertyGroup>

  <Target Name="CheckOperatorScheduleContractMirror"
          BeforeTargets="CoreCompile"
          Condition="'$(OperatorScheduleContractCheck)' == 'true'">
    <PropertyGroup>
      <_OperatorRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../..'))</_OperatorRepositoryRoot>
      <_OperatorScheduleContractGenerator>$(MSBuildProjectDirectory)/../../scripts/gen_operator_schedule_contract.py</_OperatorScheduleContractGenerator>
      <_OperatorScheduleContractArtefact>$(MSBuildProjectDirectory)/Protocol/Generated/OperatorScheduleContract.g.cs</_OperatorScheduleContractArtefact>
    </PropertyGroup>
    <Exec Command="python &quot;$(_OperatorScheduleContractGenerator)&quot; --check --root &quot;$(_OperatorRepositoryRoot)&quot; --out &quot;$(_OperatorScheduleContractArtefact)&quot;"
          ContinueOnError="true"
          StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="_OperatorScheduleContractExitCode" />
    </Exec>
    <Error Condition="'$(_OperatorScheduleContractExitCode)' != '0'"
           Text="The committed C# UserAutomation schedule contract mirror is stale against the Kernel owner contract (scripts/gen_operator_schedule_contract.py --check exited $(_OperatorScheduleContractExitCode)). Run 'python scripts/gen_operator_schedule_contract.py' from the repository root, review the diff, and commit the regenerated mirror. Do not hand-edit apps/Eliot.Operator/Protocol/Generated/OperatorScheduleContract.g.cs." />
  </Target>

  <Target Name="WriteOperatorBuildReceipt"
          AfterTargets="Publish"
          DependsOnTargets="CopyGeneratedWinUiResourcesToPublishDirectory"
          Condition="'$(OperatorBuildReceiptPath)' != ''">
    <Error Condition="'$(OperatorBuildReceiptWriterPath)' == '' or '$(OperatorBuildReceiptRepositoryRoot)' == '' or '$(OperatorBuildReceiptSourceCommit)' == '' or '$(OperatorBuildReceiptInvocationId)' == '' or '$(OperatorBuildReceiptDotnetPath)' == '' or '$(OperatorBuildReceiptPowerShellPath)' == ''"
           Text="Operator build receipt properties are incomplete." />
    <Exec Command="&quot;$(OperatorBuildReceiptPowerShellPath)&quot; -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(OperatorBuildReceiptWriterPath)&quot; -RepositoryRoot &quot;$(OperatorBuildReceiptRepositoryRoot)&quot; -PublishDirectory &quot;$([System.IO.Path]::TrimEndingDirectorySeparator('$(PublishDir)'))&quot; -ReceiptPath &quot;$(OperatorBuildReceiptPath)&quot; -SourceCommit &quot;$(OperatorBuildReceiptSourceCommit)&quot; -InvocationId &quot;$(OperatorBuildReceiptInvocationId)&quot; -DotnetPath &quot;$(OperatorBuildReceiptDotnetPath)&quot; -TargetFramework &quot;$(TargetFramework)&quot; -RuntimeIdentifier &quot;$(RuntimeIdentifier)&quot; -Platform &quot;$(PlatformTarget)&quot; -Configuration &quot;$(Configuration)&quot; -RestoreLockedMode &quot;$(RestoreLockedMode)&quot; -SelfContained &quot;$(SelfContained)&quot; -WindowsAppSDKSelfContained &quot;$(WindowsAppSDKSelfContained)&quot; -UseWinUI &quot;$(UseWinUI)&quot; -WindowsPackageType &quot;$(WindowsPackageType)&quot; -DotnetSdk &quot;$(NETCoreSdkVersion)&quot; -MSBuildVersion &quot;$(MSBuildVersion)&quot;" />
  </Target>
</Project>
