<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Eliot.Operator</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
  </ItemGroup>

  <Target Name="CopyGeneratedWinUiResourcesToPublishDirectory" AfterTargets="Publish">
    <ItemGroup>
      <_GeneratedWinUiXbf Include="$(TargetDir)**\*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pri"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(TargetDir)$(AssemblyName).pri')" />
    <Copy SourceFiles="@(_GeneratedWinUiXbf)"
          DestinationFiles="@(_GeneratedWinUiXbf->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="WriteOperatorBuildReceipt"
          AfterTargets="Publish"
          DependsOnTargets="CopyGeneratedWinUiResourcesToPublishDirectory"
          Condition="'$(OperatorBuildReceiptPath)' != ''">
    <Error Condition="'$(OperatorBuildReceiptWriterPath)' == '' or '$(OperatorBuildReceiptRepositoryRoot)' == '' or '$(OperatorBuildReceiptSourceCommit)' == '' or '$(OperatorBuildReceiptInvocationId)' == '' or '$(OperatorBuildReceiptDotnetPath)' == '' or '$(OperatorBuildReceiptPowerShellPath)' == ''"
           Text="Operator build receipt properties are incomplete." />
    <Exec Command="&quot;$(OperatorBuildReceiptPowerShellPath)&quot; -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(OperatorBuildReceiptWriterPath)&quot; -RepositoryRoot &quot;$(OperatorBuildReceiptRepositoryRoot)&quot; -PublishDirectory &quot;$([System.IO.Path]::TrimEndingDirectorySeparator('$(PublishDir)'))&quot; -ReceiptPath &quot;$(OperatorBuildReceiptPath)&quot; -SourceCommit &quot;$(OperatorBuildReceiptSourceCommit)&quot; -InvocationId &quot;$(OperatorBuildReceiptInvocationId)&quot; -DotnetPath &quot;$(OperatorBuildReceiptDotnetPath)&quot; -TargetFramework &quot;$(TargetFramework)&quot; -RuntimeIdentifier &quot;$(RuntimeIdentifier)&quot; -Platform &quot;$(PlatformTarget)&quot; -Configuration &quot;$(Configuration)&quot; -RestoreLockedMode &quot;$(RestoreLockedMode)&quot; -SelfContained &quot;$(SelfContained)&quot; -WindowsAppSDKSelfContained &quot;$(WindowsAppSDKSelfContained)&quot; -UseWinUI &quot;$(UseWinUI)&quot; -WindowsPackageType &quot;$(WindowsPackageType)&quot; -DotnetSdk &quot;$(NETCoreSdkVersion)&quot; -MSBuildVersion &quot;$(MSBuildVersion)&quot;" />
  </Target>
</Project>
